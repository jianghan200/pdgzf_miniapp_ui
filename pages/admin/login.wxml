<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh;">
  <view class="header"><text class="title">管理员登录</text></view>
  <view class="form">
    <view class="form-item"><input class="input" placeholder="用户名" value="{{userName}}" data-field="userName" bindinput="onInput"/></view>
    <view class="form-item"><input class="input" placeholder="密码" password value="{{password}}" data-field="password" bindinput="onInput"/></view>
    <button class="cu-btn bg-red lg" bindtap="login" style="width:100%;margin-top:30rpx;">登录</button>
  </view>
  <view class="menu" wx:if="{{false}}">
    <view class="menu-item" bindtap="">房源审核</view>
    <view class="menu-item" bindtap="">举报处理</view>
    <view class="menu-item" bindtap="">退款审核</view>
    <view class="menu-item" bindtap="">认证审核</view>
  </view>
</view>

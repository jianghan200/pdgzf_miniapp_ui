/* 邀请落地页样式 */

.landing-page {
  min-height: 100vh;
  background: #f6f7f9;
  padding-bottom: 60rpx;
}

/* 欢迎卡片 */
.welcome-card {
  background: linear-gradient(135deg, #1a73e8, #0d47a1);
  padding: 60rpx 40rpx 80rpx;
  text-align: center;
}

.welcome-icon {
  width: 140rpx;
  height: 140rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 30rpx;
}

.welcome-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.welcome-subtitle {
  font-size: 30rpx;
  color: rgba(255, 255, 255, 0.85);
}

/* 积分奖励卡片 */
.reward-card {
  display: flex;
  align-items: center;
  background: #ffffff;
  margin: -30rpx 30rpx 24rpx;
  padding: 30rpx;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 2;
}

.reward-icon {
  width: 80rpx;
  height: 80rpx;
  background: #fffbe6;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.reward-info {
  display: flex;
  flex-direction: column;
}

.reward-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.reward-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 6rpx;
}

/* 功能亮点 */
.feature-list {
  margin: 0 30rpx;
}

.feature-item {
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
}

.feature-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.feature-info {
  display: flex;
  flex-direction: column;
}

.feature-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.feature-desc {
  font-size: 24rpx;
  color: #888;
  margin-top: 4rpx;
}

/* CTA 区域 */
.cta-area {
  padding: 40rpx 30rpx 0;
  text-align: center;
}

.cta-btn {
  width: 100% !important;
  height: 88rpx;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.cta-hint {
  font-size: 24rpx;
  margin-top: 16rpx;
}

.bg-gold {
  background: goldenrod;
}

<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh; padding-bottom: 140rpx;">
  <view class="header"><text class="title">实名认证</text></view>
  <view class="section" wx:if="{{authStatus && authStatus.real_name_status == 1}}">
    <view class="verified"><text class="cuIcon-roundcheckfill text-green" style="font-size:80rpx;"></text><text>已认证</text></view>
  </view>
  <view wx:if="{{!authStatus || authStatus.real_name_status != 1}}">
    <view class="section">
      <view class="form-item"><text class="label">真实姓名</text><input class="input" placeholder="请输入" value="{{form.real_name}}" data-field="real_name" bindinput="onInput"/></view>
      <view class="form-item"><text class="label">身份证号</text><input class="input" placeholder="请输入" value="{{form.id_card}}" data-field="id_card" bindinput="onInput"/></view>
    </view>
    <view class="section">
      <view class="section-title">证件照</view>
      <view class="upload-area" bindtap="chooseImage">
        <image src="{{certImage}}" mode="aspectFill" wx:if="{{certImage}}" class="preview"/>
        <view class="upload-placeholder" wx:else><text class="cuIcon-add text-gray" style="font-size:60rpx;"></text><text class="upload-text">上传身份证照片</text></view>
      </view>
    </view>
    <view class="bottom-bar"><button class="cu-btn bg-red lg" bindtap="submit" disabled="{{submitting}}" style="width:100%;">提交认证</button></view>
  </view>
</view>

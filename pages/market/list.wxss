.header-bar {
  background: #fff;
  padding: 16rpx 24rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}
.slogan-row {
  margin-bottom: 12rpx;
}
.slogan-text {
  font-size: 24rpx;
  color: #999;
}
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.header-actions {
  display: flex;
  align-items: center;
}

/* 搜索 */
.cu-bar.search { padding: 12rpx 0; background: #fff; }
.search-form { display: flex; align-items: center; background: #f5f5f5; border-radius: 32rpx; padding: 12rpx 20rpx; }
.search-form .cuIcon-search { font-size: 28rpx; color: #999; margin-right: 12rpx; }
.search-form input { flex: 1; font-size: 26rpx; }

/* 快捷筛选 */
.quick-filter-bar {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-top: 16rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}
.quick-tag {
  flex-shrink: 0;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}
.quick-tag.active {
  background: #fff5f5;
  color: #e54d42;
  border: 2rpx solid #e54d42;
}
.quick-tag.more {
  background: #fff;
  border: 2rpx solid #e8e8e8;
}

/* 维度入口 */
.dimension-entry {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.dim-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.dim-item .cuIcon-subway,
.dim-item .cuIcon-locationfill,
.dim-item .cuIcon-location,
.dim-item .cuIcon-compare {
  font-size: 40rpx;
}
.dim-text {
  font-size: 24rpx;
  color: #666;
}
.text-purple { color: #9c27b0; }

.sort-bar {
  display: flex;
  gap: 40rpx;
  margin-top: 12rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #666;
}

/* 筛选抽屉 */
.filter-drawer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.filter-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
}
.filter-content {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 82%;
  background: #fff;
  padding: 40rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  overflow-y: auto;
}
.filter-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.filter-group {
  margin-bottom: 30rpx;
}
.filter-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.filter-picker {
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  width: 100%;
}
.filter-input {
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  flex: 1;
}
.filter-sep {
  margin: 0 16rpx;
  color: #999;
}
.filter-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}
.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}
.filter-actions .cu-btn {
  flex: 1;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-row .tag {
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
}
.tag-row .tag.active {
  background: #fff5f5;
  color: #e54d42;
  border-color: #e54d42;
}

/* 房源列表 */
.house-list {
  padding: 20rpx;
  padding-bottom: 120rpx;
}
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.house-cover-wrap {
  position: relative;
  width: 220rpx;
  height: 240rpx;
  flex-shrink: 0;
}
.house-cover {
  width: 220rpx;
  height: 240rpx;
}
.house-source-tag {
  position: absolute;
  top: 0;
  left: 0;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 0 8rpx 0;
}
.house-source-tag.owner { background: #e54d42; }
.house-source-tag.roommate { background: #39b54a; }
.house-source-tag.sublet { background: #fbbd08; }
.house-source-tag.apt { background: #0081ff; }
.house-info {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.house-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.house-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-cert {
  background: #e54d42;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.house-location {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
}
.location-text {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subway-dist {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}
.house-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.house-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}
.house-tags .tag {
  background: #f5f5f5;
  color: #666;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.house-tags .tag.rent-form {
  background: #fff5f5;
  color: #e54d42;
}
.house-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}
.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.house-rent {
  color: #e54d42;
  font-size: 34rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-rent-unit {
  font-size: 22rpx;
  font-weight: normal;
}
.move-in {
  font-size: 22rpx;
  color: #39b54a;
  flex-shrink: 0;
}
.house-time {
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
  white-space: nowrap;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip {
  padding-top: 200rpx;
}
.empty-text {
  margin-top: 20rpx;
}

/* 悬浮发布按钮 */
.fab-publish {
  position: fixed;
  right: 30rpx;
  bottom: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: #e54d42;
  color: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(229,77,66,0.4);
  font-size: 24rpx;
  z-index: 50;
}
.fab-publish .cuIcon-add {
  font-size: 40rpx;
  line-height: 1;
}

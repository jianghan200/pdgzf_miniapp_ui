<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh; padding-bottom: 140rpx;">
  <view class="header"><text class="title">房东认证</text></view>
  <view class="section" wx:if="{{authStatus && authStatus.landlord_status == 1}}">
    <view class="verified"><text class="cuIcon-roundcheckfill text-green" style="font-size:80rpx;"></text><text>已认证房东</text></view>
  </view>
  <view wx:if="{{!authStatus || authStatus.landlord_status != 1}}">
    <view class="section">
      <view class="section-title">房产证照片</view>
      <view class="upload-area" data-field="certImage" bindtap="chooseImage">
        <image src="{{certImage}}" mode="aspectFill" wx:if="{{certImage}}" class="preview"/>
        <view class="upload-placeholder" wx:else><text class="cuIcon-add text-gray" style="font-size:60rpx;"></text><text class="upload-text">上传房产证</text></view>
      </view>
    </view>
    <view class="section">
      <view class="section-title">租赁合同照片</view>
      <view class="upload-area" data-field="leaseImage" bindtap="chooseImage">
        <image src="{{leaseImage}}" mode="aspectFill" wx:if="{{leaseImage}}" class="preview"/>
        <view class="upload-placeholder" wx:else><text class="cuIcon-add text-gray" style="font-size:60rpx;"></text><text class="upload-text">上传租赁合同</text></view>
      </view>
    </view>
    <view class="bottom-bar"><button class="cu-btn bg-red lg" bindtap="submit" disabled="{{submitting}}" style="width:100%;">提交认证</button></view>
  </view>
</view>

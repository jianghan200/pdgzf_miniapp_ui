/**app.wxss**/
@import "/colorui/icon.wxss";
/* @import "/colorui/animation.wxss"; */
@import "/colorui/main.wxss";

.page-container {
  height: 100vh;
}

.relative-container {
  position: relative;
}

/* 浮窗运动空间 */
.movable-area {
  width: 100%;
  height: calc(100vh - 7.5rem - calc(100rpx + env(safe-area-inset-bottom) / 2));
  z-index: 100;
  position: fixed;
}

.movable-view {
  pointer-events: auto;
  z-index: 100;
  height: 70px;
  width: 70px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  box-shadow: 3px 3px 10px gray;
  border: 2px solid gray;
}

<cu-custom bgColor="bg-black" isBack="{{false}}">
  <view slot="content" style="width: auto; padding-left: 30rpx; right:auto">
    <view style="color: white; width: auto; float: left;"> 
    <text class="cuIcon-discover text-bold"></text> PD公租房 - 我的</view>
  </view>
</cu-custom>


<!-- 微信用户信息 -->
<view class="userinfo">
  <image class="{{vipInfo.type == 2 ? 'vip-' : ''}}avatar" src="{{avatarUrl}}" mode="aspectFill" bind:tap="goToEditUserInfo"></image>
  <view class="user-details">
    <view class="{{vipInfo.type == 2 ? 'vip-' : ''}}nickname" bind:tap="goToEditUserInfo">{{ nickname }}</view>
    <view class="start-date-info" bindtap="openMaunalStartDateDialog">
      <text class="start-date-label"> 资格日: </text>
      <text class="start-date-value"> {{ startDate  }}  </text>
      <text class="start-date-hint" wx:if="{{hasStartDateCode === -1}}">(模拟)</text>
      <text class="start-date-hint" wx:elif="{{hasStartDateCode === 1}}"> (点击重置)</text>
    </view>
  </view>
</view>


<!-- <movable-area class="movable-area" > -->
  <!-- 内容 -->
  <view class="cu-list menu sm-border card-menu margin-top">
    <!-- 查看会员权益 -->
    <view class="cu-item arrow" bindtap="goToRights" style="background-color: currentColor;">
      <view class="content">
        <text class="cuIcon-vip text-bold" style="color: goldenrod;"></text>
        <text class="text-bold" style="color: goldenrod;" wx:if="{{!closeIOSPay}}">成为会员(查看权益)</text>
        <text class="text-bold" style="color: goldenrod;" wx:else>更多信息请联系 meo365</text>
      </view>
    </view>

    <!-- 我的选房状态 -->
    <view class="cu-item arrow" bindtap="goToSelectDetail">
      <view class="content">
        <text class="cuIcon-home text-bold text-pink"></text>
        <text class="text-bold">我的选房状态</text>
      </view>
    </view>

    <!-- 关注房源 -->
    <view class="cu-item arrow" bindtap="goToSubscriptions">
      <view class="content">
        <text class="cuIcon-likefill text-bold text-pink"></text>
        <text class="text-bold">关注房源列表</text>
      </view>
    </view>

    <!-- 房源提醒 -->
    <view class="cu-item arrow" bindtap="gotoEmailPage">
      <view class="content">
        <text class="cuIcon-noticefill text-bold text-yellow"></text>
        <text class="text-bold">房源提醒 (关注公众号“三只熊猫工作室”)</text>
      </view>
    </view>

    <!-- 版本内容 -->
    <view class="cu-item arrow" bindtap="gotoVersions">
      <view class="content">
        <text class="cuIcon-evaluate text-bold"></text>
        <text class="text-bold">PD公租房日记</text>
      </view>
    </view>

    <!-- 默认首页 -->
    <view class="cu-item arrow" bindtap="chooseDefaultTab">
      <view class="content">
        <text class="cuIcon-apps text-bold"></text>
        <text class="text-bold">默认首页</text>
      </view>
      <view class="action">
        <text class="text-gray text-sm">{{userinfo.defaultTab === 1 ? '保租房' : userinfo.defaultTab === 2 ? '市场租房' : userinfo.defaultTab === 3 ? '社区' : '浦东公租房'}}</text>
      </view>
    </view>

    <!-- About页 -->
    <view class="cu-item arrow" bindtap="gotoAbout">
      <view class="content">
        <text class="cuIcon-info text-bold"></text>
        <text class="text-bold">关于PD公租房</text>
      </view>
    </view>
  </view>

  <!-- MVP 新增功能入口 -->
  <view class="cu-list menu sm-border card-menu margin-top">
    <view class="cu-item arrow" bindtap="goPublishMarket">
      <view class="content">
        <text class="cuIcon-edit text-bold text-orange"></text>
        <text class="text-bold">发布市场房源</text>
      </view>
    </view>
    <view class="cu-item arrow" bindtap="goMyMarketHouses">
      <view class="content">
        <text class="cuIcon-form text-bold text-orange"></text>
        <text class="text-bold">我的发布</text>
      </view>
    </view>

    <view class="cu-item arrow" bindtap="goContactList">
      <view class="content">
        <text class="cuIcon-message text-bold text-blue"></text>
        <text class="text-bold">我的联系记录</text>
      </view>
    </view>
    <view class="cu-item arrow" bindtap="goDepositList">
      <view class="content">
        <text class="cuIcon-moneybag text-bold text-yellow"></text>
        <text class="text-bold">保证金记录</text>
      </view>
    </view>
    <view class="cu-item arrow" bindtap="goRealName">
      <view class="content">
        <text class="cuIcon-people text-bold text-blue"></text>
        <text class="text-bold">实名认证</text>
      </view>
    </view>
    <view class="cu-item arrow" bindtap="goLandlordAuth">
      <view class="content">
        <text class="cuIcon-homefill text-bold text-blue"></text>
        <text class="text-bold">房东认证</text>
      </view>
    </view>
    <view class="cu-item arrow" bindtap="goVipCenter">
      <view class="content">
        <text class="cuIcon-vip text-bold text-orange"></text>
        <text class="text-bold">VIP 中心</text>
      </view>
    </view>

    <!-- 管理员入口 -->
    <view class="cu-item arrow" bindtap="goAdmin" wx:if="{{isAdmin}}">
      <view class="content">
        <text class="cuIcon-settings text-bold text-red"></text>
        <text class="text-bold">审核后台</text>
      </view>
    </view>
  </view>

<!-- </movable-area> -->

<view class="grid-container">
  <view class="cu-list grid col-3 no-border">
        <view class="cu-item" bindtap="goToNewbeePage" data-page="timeline">
          <view class="cuIcon-time"></view>
          <text>流程时间线</text>
        </view>
        <view class="cu-item" bindtap="goToNewbeePage" data-page="policy">
          <view class="cuIcon-read"></view>
          <text>信息&心得</text>
        </view>
        <view class="cu-item" bindtap="goToNewbeePage" data-page="qualification">
          <view class="cuIcon-ticket"></view>
          <text>申请资格</text>
        </view>
        <view class="cu-item" bindtap="goToNewbeePage" data-page="materials">
          <view class="cuIcon-form"></view>
          <text>申请材料</text>
        </view>
        <view class="cu-item" bindtap="goToNewbeePage" data-page="stats">
          <view class="cuIcon-rank"></view>
          <text>公租房统计数据</text>
        </view>
        <view class="cu-item" bindtap="goToNewbeePage" data-page="links">
          <view class="cuIcon-choiceness"></view>
          <text>公租房干货</text>
        </view>
        <view class="cu-item" bindtap="goToNewbeePage" data-page="stream" data-curComponentId="1">
          <view class="cuIcon-choiceness"></view>
          <text>VIP文章</text>
        </view>
      </view>
</view>


<!-- 普通用户自定义自己资格日的Modal -->
<view class="cu-modal {{openManualStartDateDialog ? 'show' : ''}}">
  <view class="cu-dialog">
    <view class="cu-bar bg-white justify-end">
      <view class="content text-bold">请输入一个资格日期</view>
      <view class="action" bindtap="closeManualStartDateDialog">
        <text class="cuIcon-close text-red"></text>
      </view>
    </view>

    <!-- 日期选择器 -->
    <view class="padding">
      <picker mode="date" value="{{ startDate }}" start="2019-01-01" end="{{today}}" bindchange="addManualStartDate">
        <view class="picker">资格日: {{ startDate == '' ? '请选择' : startDate }}</view>
      </picker>
    </view>
  </view>
</view>
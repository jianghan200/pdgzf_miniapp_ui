/* pages/houses/houses.wxss */
.title {
  font-size: larger;
  font-weight: 700;
  padding: 1rem;
}

.calendar {
  background-color: currentColor;
  padding-top: 10px;
  box-shadow: 0px 0px 10px #000;
}

.calendar-header {
  font-size: large;
}

.calendar-board {
  background-color: cornsilk;
  font-weight: 500; 
}

.cu-form-group .title {
  min-width: calc(4em + 30rpx);
}

/* 评论相关 */
.no-comment-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

/* 主页面 */
.page {
  position: fixed;
  width: 100vw;
  height: 100vh;
  left: 0vw;
  background-color: #f1f1f1;
}

.page .cu-bar.tabbar .action button.icon {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  margin: 0;
  display: inline-block;
}

.page .cu-bar.tabbar .action .cu-avatar {
  margin: 0;
}

.page .nav {
  flex: 1;
}

.page .nav .cu-item.cur {
  border-bottom: 4rpx solid;
  position: relative;
}

.page .cu-bar.tabbar .action {
  flex: initial;
}

/* 视图切换按钮 */
.view-toggle-bar {
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}

.view-toggle-btn {
  margin: 0;
  border: 0;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  font-size: 24rpx;
  padding: 0 24rpx;
}

/* 列表模式 */
.today-list {
  padding: 10rpx 20rpx;
}

.today-list-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 16rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 8rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  font-size: 26rpx;
}

.tl-name {
  font-weight: 700;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: #333;
}

.tl-size {
  min-width: 60rpx;
  text-align: center;
  color: #888;
  font-size: 24rpx;
  margin-right: 6rpx;
}

.tl-type {
  min-width: 60rpx;
  text-align: center;
  color: #888;
  font-size: 24rpx;
  margin-right: 6rpx;
}

.tl-rent {
  min-width: 100rpx;
  text-align: right;
  color: #e54d42;
  font-weight: 600;
  font-size: 24rpx;
  margin-right: 6rpx;
}

.tl-rank {
  min-width: 60rpx;
  text-align: right;
  color: #666;
  font-weight: 500;
  font-size: 24rpx;
  white-space: nowrap;
}

.tl-rank.rank-first {
  color: #19be6b;
  font-weight: 700;
}

.tl-expand {
  width: 50rpx;
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #999;
  margin-left: 6rpx;
  flex-shrink: 0;
}

.today-list-card {
  margin: -4rpx 0 8rpx 0;
  padding: 0 16rpx;
  background: #fff;
  border-radius: 0 0 12rpx 12rpx;
  overflow: hidden;
}

.vip-avatar {
  overflow: hidden; 
  width: 150rpx; 
  height: 150rpx; 
  border-radius: 50%; 
  box-shadow: 3px 3px 10px rgba(218, 165, 32, 0.959);
  border: 5px solid goldenrod;
}

.vip-nickname {
  color: goldenrod;
  font-weight: 500;
  font-size: x-large; 
  font-family: serif;
  padding: .5rem;
}

.banner {
  overflow: hidden;
  position: relative;
}

.banner .mask {
  width: 100%;
  height: 100%;
  position: absolute;
  z-index: 1;
}

.blur {
  filter:blur(5px); 
}
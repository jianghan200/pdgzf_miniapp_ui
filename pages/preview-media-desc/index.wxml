<!--pages/preview-image-video/index.wxml-->
<wxs module="func">
  module.exports = {
    getIndex: function (currentIndex, list) {
      if (currentIndex == -1) {
        return 1
      }

      if (currentIndex == -2) {
        return list.length
      }

      return currentIndex + 1
    }
  }
</wxs>

<view style="position: relative;">
  <!-- 添加一个退出的button -->
  <view style="height: {{ CustomBar }}px; display: flex; flex-direction: row; align-items: center; position: absolute; top: 0; left: 0; z-index: 9999;">
    <view class="title" style="margin-top: 30px;" catchtap="backToParent">
      <text class="cuIcon-back text-bold" style="color: white;"></text>
      <text class="text-bold" style="color: white;">返回</text>
    </view>
  </view>

  <!-- 视频集数量进度条 -->
  <view class="index-title" >{{func.getIndex(currentIndex, list)}}/{{list.length}}</view>
  
  <swiper-limited-load
    class="swiper"
    id="swiper"
    generic:item-view="item-view"
    swiperHeight="{{swiperHeight}}"
    swiperDuration="{{swiperDuration}}"
    list="{{list}}"
    scaleList="{{scaleList}}"
    scaleTempList="{{scaleTempList}}"
    current="{{current}}"
    currentSelectIndex="{{currentIndex}}"
    bindchange="swiperChange"
    bind:touchStart="touchStart"
    bind:touchMove="touchMove"
    bind:touchEnd="touchEnd"
    bind:onClickBox="onClickBox"
    bind:movableChange="movableChange"
    bind:onScale="onScale"
  ></swiper-limited-load>
</view>

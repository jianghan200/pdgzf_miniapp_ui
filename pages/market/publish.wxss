.page-title {
  font-size: 36rpx;
  font-weight: bold;
  padding: 30rpx 24rpx 10rpx;
  color: #333;
}
.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #e54d42;
  padding-left: 16rpx;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #e54d42;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 32rpx;
}
.image-add {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-label {
  width: 240rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}
.form-picker {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
  color: #333;
}
.form-row {
  display: flex;
  gap: 40rpx;
  padding: 16rpx 0;
}
.form-switch {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
}

.tags-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag-option {
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
}
.tag-option.active {
  background: #e54d42;
  color: #fff;
}
.tag-option.nearby.active {
  background: #e8954a;
  color: #fff;
}

.form-textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  min-height: 200rpx;
  font-size: 28rpx;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

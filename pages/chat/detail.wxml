<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold">{{conv.peer_nickname || '聊天'}}</view>
  </view>
</cu-custom>

<view style="background-color: #f5f5f5; min-height: 100vh; padding-bottom: 140rpx;">
  <!-- 房源快捷入口 -->
  <view class="house-bar" wx:if="{{conv && conv.house_id}}" bindtap="goHouse">
    <view class="house-title">
      <text class="house-label">房源</text>
      <text class="house-name">{{conv.house_title || '#' + conv.house_id}}</text>
    </view>
    <text class="house-go">查看 ›</text>
  </view>

  <!-- 消息列表 -->
  <view class="cu-chat" id="chat-body">
    <view class="cu-item {{item.is_self ? 'self' : ''}}" wx:for="{{messages}}" wx:key="id">
      <view class="cu-avatar round" style="background-image:url('{{conv.peer_avatar || \'/assets/user.png\'}}');">
      </view>
      <view class="main">
        <view class="content text-black" wx:if="{{item.msg_type === 'text'}}">
          <text>{{item.content}}</text>
        </view>
        <view class="content" wx:if="{{item.msg_type === 'image'}}">
          <image class="chat-img" src="{{item.content}}" mode="widthFix" data-url="{{item.content}}" bindtap="previewImage"/>
        </view>
      </view>
      <view class="date">{{item.create_time}}</view>
    </view>
  </view>

  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更早消息</view>
  <view class="load-more" wx:if="{{!loading && !hasMore && messages.length}}">没有更多了</view>
  <view class="empty" wx:if="{{!loading && messages.length == 0}}">还没有消息，快打个招呼吧</view>
</view>

<!-- 底部输入栏 -->
<view class="cu-bar bg-white shadow foot">
  <view class="action" bindtap="chooseImage">
    <text class="cuIcon-pic text-orange"></text>
  </view>
  <input class="solid-bottom chat-input" placeholder="说点什么..." value="{{inputText}}" bindinput="onInput"
         confirm-type="send" bindconfirm="sendText"/>
  <button class="cu-btn bg-red" bindtap="sendText">发送</button>
</view>

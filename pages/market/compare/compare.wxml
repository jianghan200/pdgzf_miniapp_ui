<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold">房屋对比</view>
  </view>
</cu-custom>
<view class="page-container">
  <view class="tip-bar" wx:if="{{houseIds.length > 0}}">
    <text>已选 {{houseIds.length}} 套房源，最多 4 套</text>
    <text class="clear-btn" bindtap="clearAll">清空</text>
  </view>

  <view class="empty-state" wx:if="{{houseIds.length === 0 && !loading}}">
    <text class="cuIcon-compare text-gray" style="font-size: 100rpx;"></text>
    <view class="empty-title">暂无对比房源</view>
    <view class="empty-desc">在房源详情页点击"对比"即可加入</view>
    <button class="go-btn" bindtap="goList">去选房</button>
  </view>

  <!-- 横向滚动对比表 -->
  <scroll-view scroll-x class="compare-scroll" wx:if="{{list.length > 0}}">
    <view class="compare-table">
      <!-- 第一列：维度标题 -->
      <view class="col title-col">
        <view class="cell header-cell">维度</view>
        <view class="cell">价格</view>
        <view class="cell">出租属性</view>
        <view class="cell">户型</view>
        <view class="cell">面积</view>
        <view class="cell">楼层</view>
        <view class="cell">朝向</view>
        <view class="cell">入住</view>
        <view class="cell">区域</view>
        <view class="cell">地铁</view>
        <view class="cell">电梯</view>
        <view class="cell">独卫</view>
        <view class="cell">可养宠</view>
        <view class="cell">民水民电</view>
        <view class="cell">操作</view>
      </view>

      <!-- 房源列 -->
      <view class="col house-col" wx:for="{{list}}" wx:key="id">
        <view class="cell header-cell" bindtap="openDetail" data-id="{{item.id}}">
          <image class="compare-cover" src="{{item.cover_url || '/assets/today.png'}}" mode="aspectFill"/>
          <text class="compare-title">{{item.title || item.address_name}}</text>
        </view>
        <view class="cell highlight">{{item.rent_display}}/月</view>
        <view class="cell">{{item.source_type_label || '—'}}</view>
        <view class="cell">{{item.house_type || '—'}}</view>
        <view class="cell">{{item.area ? item.area + '㎡' : '—'}}</view>
        <view class="cell">{{item.floor_desc || '—'}}</view>
        <view class="cell">{{item.orientation_label || '—'}}</view>
        <view class="cell">{{item.available_date_display}}</view>
        <view class="cell">{{item.district}} {{item.town}}</view>
        <view class="cell">{{item.subway_info || '—'}}</view>
        <view class="cell">{{item.elevator == 1 ? '有' : '无'}}</view>
        <view class="cell">{{item.bathroom_type === 'private' ? '有' : '无'}}</view>
        <view class="cell">{{item.pet_friendly == 1 ? '可' : '不可'}}</view>
        <view class="cell">{{item.civil_meters == 1 ? '是' : '否'}}</view>
        <view class="cell">
          <text class="remove-text" data-id="{{item.id}}" catchtap="removeItem">移除</text>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
</view>
<wxs src="../../../utils/tool.wxs" module="tools" />

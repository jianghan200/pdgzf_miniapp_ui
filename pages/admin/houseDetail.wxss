/* ========== 加载状态 ========== */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}
.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #e5e5e5;
  border-top-color: #e54d42;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.loading-text {
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* ========== 照片画廊 ========== */
.gallery-section {
  position: relative;
}
.gallery-swiper {
  width: 100%;
  height: 480rpx;
}
.gallery-img {
  width: 100%;
  height: 100%;
}
.gallery-count {
  position: absolute;
  bottom: 16rpx;
  right: 16rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

/* ========== 通用 Section ========== */
.section {
  background: #fff;
  margin: 16rpx 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}
.section-dot {
  width: 8rpx;
  height: 28rpx;
  border-radius: 4rpx;
  background: #e54d42;
  margin-right: 12rpx;
  flex-shrink: 0;
}
.section-dot.dot-warn {
  background: #ff9800;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* ========== 标题 Hero ========== */
.info-hero {
  margin-top: 0;
  border-radius: 0 0 16rpx 16rpx;
}
.hero-top {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}
.hero-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
  flex: 1;
  min-width: 0;
  line-height: 1.3;
}
.status-tag {
  background: #fff7e6;
  border: 1rpx solid #ffd591;
  color: #d48806;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}
.hero-rent {
  font-size: 40rpx;
  font-weight: 800;
  color: #e54d42;
  margin-bottom: 8rpx;
}
.hero-location {
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* ========== 核心指标网格 ========== */
.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr 1fr;
  gap: 16rpx;
}
.stat-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0;
  background: #f8f9fa;
  border-radius: 12rpx;
}
.stat-num {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1a1a;
  line-height: 1.3;
}
.stat-unit {
  font-size: 18rpx;
  color: #999;
  margin-top: 4rpx;
}

/* ========== 详细属性 ========== */
.detail-rows {
  display: flex;
  flex-direction: column;
}
.detail-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}
.detail-row:last-child {
  border-bottom: none;
}
.row-label {
  font-size: 24rpx;
  color: #999;
  flex-shrink: 0;
}
.row-value {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
  text-align: right;
  max-width: 60%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vip-text {
  color: #faad14;
}

/* ========== 特色标签 ========== */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.feat-tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #f5f5f5;
  color: #999;
}
.feat-tag.feat-active {
  background: #fff0f0;
  color: #e54d42;
  font-weight: 500;
}

/* ========== 描述 ========== */
.desc-text {
  font-size: 26rpx;
  color: #555;
  line-height: 1.75;
  white-space: pre-wrap;
}

/* ========== 设施 / 周边标签 ========== */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.facility-tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #f0f5ff;
  color: #597ef7;
}
.nearby-tag {
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  background: #f6ffed;
  color: #52c41a;
}

/* ========== 联系方式 ========== */
.contact-card {
  background: #f8f9fa;
  border-radius: 12rpx;
  padding: 4rpx 20rpx;
}
.contact-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}
.contact-row:last-child {
  border-bottom: none;
}
.contact-label {
  font-size: 24rpx;
  color: #999;
}
.contact-value {
  font-size: 26rpx;
  color: #333;
  font-weight: 600;
}
.contact-phone {
  color: #1890ff;
}

/* ========== 驳回原因 ========== */
.reject-wrap {
  position: relative;
}
.reject-input {
  background: #f8f9fa;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  min-height: 180rpx;
  font-size: 26rpx;
  color: #333;
  box-sizing: border-box;
}
.reject-input:focus {
  border-color: #ff9800;
}
.reject-count {
  position: absolute;
  bottom: 12rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: #ccc;
}

/* ========== 底部操作栏 ========== */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  gap: 20rpx;
  z-index: 100;
}
.bar-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 88rpx;
  padding: 0;
}
.bar-btn::after {
  border: none;
}
.bar-reject {
  background: #f5f5f5;
  color: #666;
}
.bar-approve {
  background: linear-gradient(135deg, #52c41a, #389e0d);
  color: #fff;
}

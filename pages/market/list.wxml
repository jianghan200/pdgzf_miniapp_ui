<cu-custom bgColor="bg-white" isBack="{{false}}">
  <view slot="content">
    <view class="text-bold" style="color: var(--color-text-1, #1A1A1A);">PD租房 · 市场租房</view>
  </view>
</cu-custom>
<view style="background-color: #F7F8FA; min-height: 100vh;">
  <!-- 顶部栏 -->
  <view class="header-bar">

    <!-- 维度入口 -->
    <!-- <view class="dimension-entry">
      <view class="dim-item" bindtap="goSubwaySearch">
        <text class="cuIcon-subway text-blue"></text>
        <text class="dim-text">地铁找房</text>
      </view>
      <view class="dim-item" bindtap="goCommuteSearch">
        <text class="cuIcon-locationfill text-green"></text>
        <text class="dim-text">公司通勤</text>
      </view>
      <view class="dim-item" bindtap="goMapSearch">
        <text class="cuIcon-location text-orange"></text>
        <text class="dim-text">地图找房</text>
      </view>
      <view class="dim-item" bindtap="goCompare">
        <text class="cuIcon-compare text-purple"></text>
        <text class="dim-text">房屋对比</text>
      </view>
    </view>  -->

    <!-- 动态通知轮播（降噪：无底色、无脉冲点） -->
    <view class="notice-bar" wx:if="{{notices.length > 0}}">
      <text class="cuIcon-notification notice-icon"></text>
      <swiper class="notice-swiper" autoplay="{{true}}" interval="{{3500}}" circular="{{true}}" vertical="{{true}}" display-multiple-items="1" duration="{{400}}">
        <swiper-item wx:for="{{notices}}" wx:key="id" bindtap="onNoticeTap" data-url="{{item.link_url}}">
          <view class="notice-item">
            <text class="notice-text">{{item.title}}</text>
          </view>
        </swiper-item>
      </swiper>
    </view>

    <!-- 搜索框 -->
    <view class="cu-bar bg-white search">
      <view class="search-form round">
        <text class="cuIcon-search"></text>
        <input type="text" placeholder="搜索小区 / 地铁 / 公司 / 商圈" confirm-type="search" bindinput="onSearchInput" bindconfirm="onSearchConfirm" />
      </view>
    </view>

    <!-- 快捷筛选标签 -->
    <view class="quick-filter-bar">
      <view
        class="quick-tag {{filters[item.key] == item.value ? 'active' : ''}}"
        wx:for="{{quickTags}}"
        wx:key="label"
        data-key="{{item.key}}"
        data-value="{{item.value}}"
        bindtap="onQuickTagTap"
      >{{item.label}}</view>
      <view class="quick-tag more" bindtap="toggleFilter"><text class="cuIcon-filter" style="margin-right: 4rpx;"></text>筛选</view>
    </view>

    <!-- 排序条 -->
    <view class="sort-bar">
      <picker mode="selector" range="{{sortOptions}}" value="{{sortIndex}}" bindchange="onSortChange">
        <view class="sort-item">{{sortOptions[sortIndex]}} <text class="cuIcon-triangledownfill sort-arrow"></text></view>
      </picker>
      <picker mode="selector" range="{{districts}}" value="{{districtIndex}}" bindchange="onDistrictChange">
        <view class="sort-item">{{districts[districtIndex]}} <text class="cuIcon-triangledownfill sort-arrow"></text></view>
      </picker>
      <view class="sort-right" wx:if="{{newHouseCount > 0}}" bindtap="scrollToTop">
        <view class="new-count-dot"></view>
        <text class="new-count-text">{{newHouseCount}} 套新上架</text>
      </view>
    </view>
  </view>

  <!-- 筛选抽屉 - 底部弹窗 -->
  <view class="filter-drawer {{showFilter ? 'show' : ''}}" catchtouchmove="true">
    <view class="filter-mask" bindtap="closeFilter"></view>
    <view class="filter-sheet {{showFilter ? 'sheet-show' : ''}}">
      <view class="sheet-handle"><view class="handle-bar"></view></view>
      <view class="sheet-header">
        <text class="sheet-title">筛选</text>
        <view class="sheet-close" bindtap="closeFilter">
          <text class="cuIcon-close"></text>
        </view>
      </view>

      <scroll-view class="sheet-body" scroll-y enhanced show-scrollbar="{{false}}">

        <!-- 出租形式 -->
        <view class="filter-section">
          <view class="sub-section">
            <view class="tag-grid">
              <view class="ftag ftag-sm {{draftFilters.rent_type === 'whole' ? 'ftag-active' : ''}}" data-field="rent_type" data-value="whole" bindtap="setDraftSingle">整租</view>
              <view class="ftag ftag-sm {{draftFilters.rent_type === 'share' ? 'ftag-active' : ''}}" data-field="rent_type" data-value="share" bindtap="setDraftSingle">合租</view>
            </view>
          </view>
        </view>

        <!-- 户型 + 入住日期 -->
        <view class="filter-section">
          <view class="sub-section">
            <text class="sub-label">户型</text>
            <view class="tag-grid">
              <view class="ftag ftag-sm {{draftFilters.room_shape === 'loft' ? 'ftag-active' : ''}}" data-field="room_shape" data-value="loft" bindtap="setDraftMutex">Loft</view>
              <view class="ftag ftag-sm {{draftFilters.room_shape === 'studio' ? 'ftag-active' : ''}}" data-field="room_shape" data-value="studio" bindtap="setDraftMutex">一室户</view>
              <view class="ftag ftag-sm {{draftFilters.bedrooms === '1' ? 'ftag-active' : ''}}" data-field="bedrooms" data-value="1" bindtap="setDraftMutex">一室</view>
              <view class="ftag ftag-sm {{draftFilters.bedrooms === '2' ? 'ftag-active' : ''}}" data-field="bedrooms" data-value="2" bindtap="setDraftMutex">二室</view>
              <view class="ftag ftag-sm {{draftFilters.bedrooms === '3' ? 'ftag-active' : ''}}" data-field="bedrooms" data-value="3" bindtap="setDraftMutex">三室</view>
              <view class="ftag ftag-sm {{draftFilters.bedrooms === '4' ? 'ftag-active' : ''}}" data-field="bedrooms" data-value="4" bindtap="setDraftMutex">四室+</view>
            </view>
          </view>
          <!-- <view class="sub-section">
            <text class="sub-label">入住日期</text>
            <view class="tag-grid">
              <view class="ftag ftag-sm {{draftFilters.move_in === 'now' ? 'ftag-active' : ''}}" data-field="move_in" data-value="now" bindtap="setDraftSingle">立即入住</view>
              <view class="ftag ftag-sm {{draftFilters.move_in === '7d' ? 'ftag-active' : ''}}" data-field="move_in" data-value="7d" bindtap="setDraftSingle">7天内</view>
              <view class="ftag ftag-sm {{draftFilters.move_in === '30d' ? 'ftag-active' : ''}}" data-field="move_in" data-value="30d" bindtap="setDraftSingle">30天内</view>
            </view>
          </view> -->
        </view>

        <!-- 价格区间 -->
        <view class="filter-section">
          <view class="section-title">价格区间</view>
          <view class="price-input-row">
            <view class="price-input-wrap">
              <text class="price-prefix">¥</text>
              <input class="price-input" type="number" placeholder="最低" value="{{draftFilters.rent_min}}" bindinput="onDraftRentMinInput"/>
            </view>
            <text class="price-dash">—</text>
            <view class="price-input-wrap">
              <text class="price-prefix">¥</text>
              <input class="price-input" type="number" placeholder="最高" value="{{draftFilters.rent_max}}" bindinput="onDraftRentMaxInput"/>
            </view>
          </view>
        </view>


        <!-- 更多条件 -->
        <view class="filter-section">
          <view class="section-title">更多条件</view>
          <view class="tag-grid tag-cloud">
            <view class="ftag ftag-sm {{draftFilters.has_private_bathroom ? 'ftag-active' : ''}}" data-field="has_private_bathroom" bindtap="toggleDraftFlag">
              <text>独卫</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.private_kitchen ? 'ftag-active' : ''}}" data-field="private_kitchen" bindtap="toggleDraftFlag">
              <text>独立厨房</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.elevator ? 'ftag-active' : ''}}" data-field="elevator" bindtap="toggleDraftFlag">
              <text>电梯</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.south ? 'ftag-active' : ''}}" data-field="south" bindtap="toggleDraftFlag">
              <text>朝南</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.gas ? 'ftag-active' : ''}}" data-field="gas" bindtap="toggleDraftFlag">
              <text>天然气</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.civil_meters ? 'ftag-active' : ''}}" data-field="civil_meters" bindtap="toggleDraftFlag">
              <text>民水民电</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.pet_friendly ? 'ftag-active' : ''}}" data-field="pet_friendly" bindtap="toggleDraftFlag">
              <text>可养宠物</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.not_first_floor ? 'ftag-active' : ''}}" data-field="not_first_floor" bindtap="toggleDraftFlag">
              <text>非一楼</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.not_top_floor ? 'ftag-active' : ''}}" data-field="not_top_floor" bindtap="toggleDraftFlag">
              <text>非顶层</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.not_basement ? 'ftag-active' : ''}}" data-field="not_basement" bindtap="toggleDraftFlag">
              <text>非地下室</text>
            </view>
            <view class="ftag ftag-sm {{draftFilters.not_attic ? 'ftag-active' : ''}}" data-field="not_attic" bindtap="toggleDraftFlag">
              <text>非阁楼</text>
            </view>
          </view>
        </view>

                <!-- 房屋属性 + 建筑类型 -->
        <view class="filter-section">
          <view class="sub-section">
            <text class="sub-label">房屋属性</text>
            <view class="tag-grid">
              <view class="ftag ftag-sm {{draftFilters.property_type === 'commercial' ? 'ftag-active' : ''}}" data-field="property_type" data-value="commercial" bindtap="setDraftSingle">商品房</view>
              <view class="ftag ftag-sm {{draftFilters.property_type === 'relocation' ? 'ftag-active' : ''}}" data-field="property_type" data-value="relocation" bindtap="setDraftSingle">动迁房</view>
              <!-- <view class="ftag ftag-sm {{draftFilters.property_type === 'affordable' ? 'ftag-active' : ''}}" data-field="property_type" data-value="affordable" bindtap="setDraftSingle">经适房</view> -->
              <!-- <view class="ftag ftag-sm {{draftFilters.property_type === 'civilian' ? 'ftag-active' : ''}}" data-field="property_type" data-value="civilian" bindtap="setDraftSingle">民房</view> -->
              <view class="ftag ftag-sm {{draftFilters.property_type === 'apartment' ? 'ftag-active' : ''}}" data-field="property_type" data-value="apartment" bindtap="setDraftSingle">公寓</view>
              <!-- <view class="ftag ftag-sm {{draftFilters.property_type === 'talent_apt' ? 'ftag-active' : ''}}" data-field="property_type" data-value="talent_apt" bindtap="setDraftSingle">人才公寓</view> -->
              <view class="ftag ftag-sm {{draftFilters.property_type === 'bao_rent' ? 'ftag-active' : ''}}" data-field="property_type" data-value="bao_rent" bindtap="setDraftSingle">保租房</view>
              <!-- <view class="ftag ftag-sm {{draftFilters.property_type === 'public_rent' ? 'ftag-active' : ''}}" data-field="property_type" data-value="public_rent" bindtap="setDraftSingle">公租房</view> -->
            </view>
          </view>
          <view class="sub-section">
            <text class="sub-label">建筑类型</text>
            <view class="tag-grid">
              <view class="ftag ftag-sm {{draftFilters.building_type === 'low_rise' ? 'ftag-active' : ''}}" data-field="building_type" data-value="low_rise" bindtap="setDraftSingle">小高层</view>
              <view class="ftag ftag-sm {{draftFilters.building_type === 'high_rise' ? 'ftag-active' : ''}}" data-field="building_type" data-value="high_rise" bindtap="setDraftSingle">高层</view>
              <view class="ftag ftag-sm {{draftFilters.building_type === 'villa' ? 'ftag-active' : ''}}" data-field="building_type" data-value="villa" bindtap="setDraftSingle">别墅</view>
              <view class="ftag ftag-sm {{draftFilters.building_type === 'stacked' ? 'ftag-active' : ''}}" data-field="building_type" data-value="stacked" bindtap="setDraftSingle">叠墅</view>
              <view class="ftag ftag-sm {{draftFilters.building_type === 'super_high' ? 'ftag-active' : ''}}" data-field="building_type" data-value="super_high" bindtap="setDraftSingle">超高层</view>
              <view class="ftag ftag-sm {{draftFilters.building_type === 'bungalow' ? 'ftag-active' : ''}}" data-field="building_type" data-value="bungalow" bindtap="setDraftSingle">平房</view>
            </view>
          </view>
        </view>

         <!-- 房源来源 + 出租形式 -->
         <view class="filter-section">
          <view class="sub-section">
            <text class="sub-label">房源来源</text>
            <view class="tag-grid">
              <view class="ftag ftag-sm {{draftFilters.rent_source === 'owner' ? 'ftag-active' : ''}}" data-field="rent_source" data-value="owner" bindtap="setDraftSingle">房东直租</view>
              <view class="ftag ftag-sm {{draftFilters.rent_source === 'roommate' ? 'ftag-active' : ''}}" data-field="rent_source" data-value="roommate" bindtap="setDraftSingle">合租找室友</view>
              <view class="ftag ftag-sm {{draftFilters.rent_source === 'sublet' ? 'ftag-active' : ''}}" data-field="rent_source" data-value="sublet" bindtap="setDraftSingle">转租</view>
              <view class="ftag ftag-sm {{draftFilters.rent_source === 'apt' ? 'ftag-active' : ''}}" data-field="rent_source" data-value="apt" bindtap="setDraftSingle">公寓直租</view>
            </view>
          </view>
        </view>


        <view style="height: 16rpx;"></view>
      </scroll-view>

      <view class="sheet-footer">
        <button class="btn-reset" bindtap="resetFilter">重置</button>
        <button class="btn-apply" bindtap="applyFilter">确定</button>
      </view>
    </view>
  </view>

  <!-- 房源列表 -->
  <view class="house-list">
    <view class="house-card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="house-cover-wrap">
        <image class="house-cover" src="{{item.cover_url || '/assets/today.png'}}" mode="aspectFill"/>
      </view>
      <view class="house-info">
        <view class="house-title-row">
          <text class="house-title">{{item.title || item.address_name}}</text>
          <text class="house-source-tag-inline {{item.source_type}}" wx:if="{{item.source_type_label}}">{{item.source_type_label}}</text>
          <text class="house-cert" wx:if="{{item.is_certified == 1}}">认证</text>
        </view>
        <view class="house-location">
          <text class="location-text">{{item.district || ''}} {{item.town || ''}} {{item.address_name || ''}}</text>
          <text class="subway-dist" wx:if="{{item.distance}}">· 距地铁{{item.distance}}m</text>
        </view>
        <view class="house-meta">
          <text>{{item.rent_type_label}}</text>
          <text wx:if="{{item.house_type}}">· {{item.house_type}}</text>
          <text wx:if="{{item.area}}">· {{item.area}}㎡</text>
          <text wx:if="{{item.floor_desc}}">· {{item.floor_desc}}</text>
        </view>
        <view class="house-bottom">
          <view class="price-wrap">
            <text class="house-rent">{{item.rent_display}}</text>
            <text class="house-rent-unit">/月</text>
          </view>
          <view class="house-bottom-right">
            <text class="move-in" wx:if="{{item.available_date_display}}">{{item.available_date_display}}</text>
            <text class="house-time" wx:if="{{item.time_display}}">· {{item.time_display}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <view class="loading-tip" wx:if="{{!hasMore && list.length > 0}}">没有更多了</view>
  <view class="empty-tip" wx:if="{{!loading && list.length == 0}}">
    <text class="cuIcon-text text-gray" style="font-size: 80rpx;"></text>
    <view class="empty-text">暂无房源</view>
  </view>

  <!-- 悬浮发布按钮 -->
  <view class="fab-publish" bindtap="goPublish">
    <text class="cuIcon-add"></text>
    <text>发布</text>
  </view>
</view>

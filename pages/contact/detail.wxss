.loading { text-align: center; padding: 200rpx; color: #999; }
.section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; border-left: 6rpx solid #e54d42; padding-left: 16rpx; }
.msg-row { display: flex; justify-content: space-between; padding: 12rpx 0; font-size: 28rpx; }
.label { color: #999; }
.msg-content { font-size: 28rpx; color: #333; line-height: 1.6; }
.reply-time { font-size: 22rpx; color: #ccc; margin-top: 12rpx; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 20rpx; background: #fff; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }
.reply-input { flex: 1; background: #f5f5f5; border-radius: 8rpx; padding: 0 20rpx; font-size: 28rpx; }

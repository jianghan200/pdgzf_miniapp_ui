.header-bar {
  background: #fff;
  padding: 16rpx 24rpx 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}
.slogan-row {
  margin-bottom: 12rpx;
}
.slogan-text {
  font-size: 24rpx;
  color: #999;
}
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.header-actions {
  display: flex;
  align-items: center;
}

/* 搜索 */
.cu-bar.search { padding: 12rpx 0; background: #fff; }
.search-form { display: flex; align-items: center; background: #f5f5f5; border-radius: 32rpx; padding: 12rpx 20rpx; }
.search-form .cuIcon-search { font-size: 28rpx; color: #999; margin-right: 12rpx; }
.search-form input { flex: 1; font-size: 26rpx; }

/* 快捷筛选 */
.quick-filter-bar {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-top: 16rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}
.quick-tag {
  flex-shrink: 0;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}
.quick-tag.active {
  background: #fff5f5;
  color: #e54d42;
  border: 2rpx solid #e54d42;
}
.quick-tag.more {
  background: #fff;
  border: 2rpx solid #e8e8e8;
}

/* 维度入口 */
.dimension-entry {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 16rpx 0;
  border-top: 1rpx solid #f0f0f0;
}
.dim-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.dim-item .cuIcon-subway,
.dim-item .cuIcon-locationfill,
.dim-item .cuIcon-location,
.dim-item .cuIcon-compare {
  font-size: 40rpx;
}
.dim-text {
  font-size: 24rpx;
  color: #666;
}
.text-purple { color: #9c27b0; }

.sort-bar {
  display: flex;
  gap: 40rpx;
  margin-top: 12rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #666;
}

/* ===== 筛选抽屉 - 底部弹窗 ===== */
.filter-drawer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  visibility: hidden;
  transition: visibility 0s 0.35s;
}
.filter-drawer.show {
  visibility: visible;
  transition: visibility 0s 0s;
}
.filter-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
}
.filter-drawer.show .filter-mask {
  background: rgba(0, 0, 0, 0.45);
}

/* 底部弹窗主体 */
.filter-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 85vh;
  background: #f7f8fa;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}
.filter-sheet.sheet-show {
  transform: translateY(0);
}

/* 拖拽手柄 */
.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
}
.handle-bar {
  width: 56rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #d8d8d8;
}

/* 顶部栏 */
.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 14rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #f0f0f0;
}
.sheet-close .cuIcon-close {
  font-size: 24rpx;
  color: #999;
}

/* 可滚动内容 */
.sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 20rpx;
}

/* 筛选分区 */
.filter-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}
/* 卡片内子分组 */
.sub-section {
  padding: 0;
}
.sub-section + .sub-section {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f2f3f5;
}
.sub-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #888;
  display: block;
  margin-bottom: 12rpx;
}

/* 标签网格 */
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 标签样式 */
.ftag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #f5f7fa;
  color: #555;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  flex: 1;
  min-width: 0;
}
.ftag:active {
  transform: scale(0.96);
}
.ftag-sm {
  padding: 12rpx 0;
  font-size: 24rpx;
  border-radius: 10rpx;
}
/* 标签云：自然宽度，不拉伸 */
.tag-cloud {
  gap: 12rpx;
}
.tag-cloud .ftag {
  flex: 0 0 auto;
  width: auto;
  padding: 12rpx 20rpx;
}
.tag-cloud .ftag:active {
  transform: scale(0.96);
}
.ftag-icon {
  font-size: 22rpx;
  line-height: 1;
}
.ftag-active {
  background: #fff0f0;
  color: #e54d42;
  border-color: #e54d42;
  font-weight: 600;
}

/* 价格输入 */
.price-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.price-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 68rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}
.price-input-wrap:focus-within {
  border-color: #e54d42;
  background: #fff;
}
.price-prefix {
  font-size: 26rpx;
  font-weight: 600;
  color: #bbb;
  margin-right: 6rpx;
}
.price-input {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  height: 68rpx;
}
.price-dash {
  font-size: 26rpx;
  color: #ccc;
}

/* 底部操作栏 */
.sheet-footer {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 28rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
}
.btn-reset {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #f5f7fa;
  color: #666;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  padding: 0;
}
.btn-apply {
  flex: 2;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: linear-gradient(135deg, #ff6b6b 0%, #e54d42 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  padding: 0;
  box-shadow: 0 4rpx 16rpx rgba(229, 77, 66, 0.3);
}
.btn-apply:active {
  opacity: 0.85;
}
.btn-reset:active {
  background: #ebedf0;
}

/* 房源列表 */
.house-list {
  padding: 20rpx;
  padding-bottom: 120rpx;
}
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.house-cover-wrap {
  position: relative;
  width: 220rpx;
  height: 240rpx;
  flex-shrink: 0;
}
.house-cover {
  width: 220rpx;
  height: 240rpx;
}
.house-source-tag {
  position: absolute;
  top: 0;
  left: 0;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 0 8rpx 0;
}
.house-source-tag.owner { background: #e54d42; }
.house-source-tag.roommate { background: #39b54a; }
.house-source-tag.sublet { background: #fbbd08; }
.house-source-tag.apt { background: #0081ff; }
.house-info {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.house-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.house-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-cert {
  background: #e54d42;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}
.house-location {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 8rpx;
}
.location-text {
  font-size: 24rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subway-dist {
  font-size: 22rpx;
  color: #999;
  flex-shrink: 0;
}
.house-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.house-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}
.house-tags .tag {
  background: #f5f5f5;
  color: #666;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
}
.house-tags .tag.rent-form {
  background: #fff5f5;
  color: #e54d42;
}
.house-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}
.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.house-rent {
  color: #e54d42;
  font-size: 34rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-rent-unit {
  font-size: 22rpx;
  font-weight: normal;
}
.move-in {
  font-size: 22rpx;
  color: #39b54a;
  flex-shrink: 0;
}
.house-time {
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
  white-space: nowrap;
}

.loading-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip {
  padding-top: 200rpx;
}
.empty-text {
  margin-top: 20rpx;
}

/* 悬浮发布按钮 */
.fab-publish {
  position: fixed;
  right: 30rpx;
  bottom: 40rpx;
  width: 120rpx;
  height: 120rpx;
  background: #e54d42;
  color: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(229,77,66,0.4);
  font-size: 24rpx;
  z-index: 50;
}
.fab-publish .cuIcon-add {
  font-size: 40rpx;
  line-height: 1;
}

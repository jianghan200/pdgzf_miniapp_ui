<wxs src="../../utils/tool.wxs" module="tools" />

<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold">{{article.title}}</view>
  </view>
</cu-custom>

<view style="height: 50px;"></view>
<view class="cu-bar bg-white solid-bottom {{isCard?'margin-top':''}}">
  <view class='action'>
    <text class='cuIcon-titles text-orange '></text> {{article.title}}
  </view>
  <view class='action'>
    <switch class='sm' checked='{{isCard}}' bindchange='isCard'></switch>
  </view>
</view>
<view class="cu-card dynamic {{isCard?'no-card':''}}">
  <view class="cu-item shadow">
    <view class="cu-list menu-avatar">
      <view class="cu-item">
        <view class="cu-avatar round lg" style="background-image:url({{article.user_avatar}});"></view>
        <view class="content flex-sub">
          <view>{{article.user_nickname}}</view>
          <view class="text-gray text-sm flex justify-between">
            {{article.create_gmt_simple}}
          </view>
        </view>
      </view>
    </view>
    <view class="text-content">
      {{article.content}}
    </view>
    <view class="grid flex-sub padding-lr {{isCard?'col-3 grid-square':'col-1'}}">
      <view class="image">
        <image src="{{article.images[0]}}" mode="widthFix"></image>
      </view>
    </view>
    <view class="text-gray text-sm text-right padding">
      <text class="cuIcon-attentionfill margin-lr-xs"></text> {{article.view}}
      <text class="cuIcon-appreciatefill margin-lr-xs"></text> {{article.like_count}}
      <text class="cuIcon-messagefill margin-lr-xs"></text> {{article.comment_count}}
    </view>
    <view class="cu-list menu-avatar comment solids-top">
      <view wx:for="{{article.comment}}" wx:key="aid"  data-id="{{item.aid}}"  class="cu-item">
        <view class="cu-avatar round" style="background-image:url({{item.avatarUrl}});"></view>
        <view class="content">
          <view class="text-grey"> {{item.nickName}} </view>
          <view class="text-gray text-content text-df">
            {{item.comment}}
          </view>
          <view class="margin-top-sm flex justify-between">
            <view class="text-gray text-df">{{item.create_gmt}}</view>
            <view>
              <text class="cuIcon-appreciatefill text-red"></text>
              <text class="cuIcon-messagefill text-gray margin-left-sm"></text>
            </view>
          </view>
        </view>
      </view>

    </view>
  </view>
</view>
<!-- tabBar -->

<!-- 评论输入 -->
<view 
  class="cu-bar foot input {{ commentInputHeight != 0 ? 'cur' : '' }}" 
  style="bottom: {{commentInputHeight}}px;"
>
  <textarea 
    placeholder="赠人以言，重于珠玉~"
    class="solid-bottom" 
    adjust-position="false" 
    maxlength="300" 
    cursor-spacing="10"
    bindfocus="onFocusCommentInput"
    bindblur="onBlurCommentInput"
    bindinput="inputComment"
    auto-height="true"
  ></textarea>
  <button class="cu-btn bg-green shadow" bindtap="submitComment">发送</button>
</view>  
<tabBar bindswitchtab="redirect" tab="subscribe"></tabBar>
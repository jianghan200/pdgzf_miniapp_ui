.loading-box { text-align: center; padding: 200rpx; }
.media-swiper { width: 100%; height: 500rpx; }
.media-img { width: 100%; height: 100%; }
.section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; border-left: 6rpx solid #39b54a; padding-left: 16rpx; }
.title { font-size: 36rpx; font-weight: bold; }
.meta-row { display: flex; align-items: center; gap: 8rpx; margin-top: 12rpx; font-size: 28rpx; color: #666; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; margin-top: 16rpx; }
.tag { background: #f0faf0; color: #39b54a; font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 6rpx; }
.desc { font-size: 28rpx; color: #666; line-height: 1.6; }
.room-list { display: flex; flex-direction: column; gap: 16rpx; }
.room-item { padding: 20rpx; background: #f9f9f9; border-radius: 12rpx; }
.room-header { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 12rpx; }
.room-name { font-weight: bold; font-size: 30rpx; }
.room-bedrooms { font-size: 24rpx; color: #999; }
.room-detail-row { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.room-label { font-size: 26rpx; color: #999; width: 3em; }
.room-value { font-size: 28rpx; color: #333; }
.room-rent { color: #e54d42; font-weight: bold; }
.facilities { display: flex; flex-wrap: wrap; gap: 16rpx; }
.facility { background: #eef; color: #6699cc; font-size: 26rpx; padding: 8rpx 20rpx; border-radius: 20rpx; }
.map-nav { display: flex; align-items: center; gap: 8rpx; font-size: 28rpx; color: #39b54a; font-weight: 500; margin-bottom: 16rpx; }
.map-container { width: 100%; height: 350rpx; border-radius: 12rpx; overflow: hidden; }

/* 集中配租时间窗 */
.supply-card { background: #fffaf0; border: 2rpx solid #ffe7b3; border-radius: 12rpx; padding: 20rpx; }
.supply-row { display: flex; align-items: center; gap: 16rpx; margin-bottom: 12rpx; }
.supply-label { font-size: 26rpx; color: #b8860b; width: 5em; flex-shrink: 0; }
.supply-value { font-size: 26rpx; color: #333; }
.supply-countdown { margin-top: 8rpx; font-size: 28rpx; color: #e54d42; font-weight: bold; }

/* 联系电话 */
.tel-row { display: flex; align-items: center; gap: 12rpx; padding: 20rpx 0; border-bottom: 2rpx solid #f5f5f5; }
.tel-row:last-child { border-bottom: none; }
.tel-label { font-size: 26rpx; color: #999; background: #f5f5f5; padding: 4rpx 14rpx; border-radius: 12rpx; }
.tel-num { flex: 1; font-size: 30rpx; color: #333; font-weight: 600; }
.tel-lock { font-size: 22rpx; color: #e54d42; background: rgba(229,77,66,0.12); padding: 4rpx 14rpx; border-radius: 12rpx; margin-right: 8rpx; }

/* 户型状态 */
.room-status { margin-left: auto; font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 12rpx; }
.room-status.dt-avail { background: rgba(57,181,74,0.12); color: #39b54a; }
.room-status.dt-full { background: #f0f0f0; color: #999; }
.room-queue { color: #e54d42; font-weight: 600; }
.room-avail { color: #39b54a; font-weight: 600; }
.disclaimer { margin-top: 16rpx; font-size: 22rpx; color: #bbb; line-height: 1.5; }

/* 准入与配租 */
.rules-card { background: #f9f9f9; border-radius: 12rpx; padding: 20rpx; margin-bottom: 16rpx; }
.rules-header { display: flex; align-items: center; justify-content: space-between; }
.rules-title { font-size: 28rpx; font-weight: 600; color: #333; }
.rules-desc { margin-top: 16rpx; font-size: 26rpx; color: #666; line-height: 1.7; white-space: pre-wrap; }

            <text class="cuIcon-lock text-white"></text>
          </view>
          <view class="lock-text-box">
            <text class="lock-title">联系方式已隐藏</text>
            <text class="lock-desc">{{contactMethod === 'ad' ? '观看完整广告后可获得联系方式（24小时内有效）' : '支付 ¥1 即可获取房东联系方式'}}</text>
          </view>
          <text class="cuIcon-right text-gray"></text>
        </view>
      </block>
    </view> -->

    <!-- 作者/管理员操作 -->
    <view class="section" wx:if="{{isOwner || isAdmin}}">
      <view class="section-title">{{isOwner ? '房东操作' : '管理操作'}}</view>
      <view class="owner-actions">
        <button class="cu-btn bg-blue" bindtap="editHouse">编辑房源</button>
        <button class="cu-btn bg-gray" bindtap="offlineHouse">下架房源</button>
      </view>
    </view>

    <!-- 评论区 -->
    <comment-section wx:if="{{detail}}" id="comment-section" hide-trigger="{{true}}"
      target-type="market_house" target-id="{{id}}"/>
  </block>

  <!-- 底部操作栏 -->
  <view class="bottom-bar" wx:if="{{detail && !adUnlocked && !detail.contact_visible}}">
    <view class="bar-action" bindtap="toggleFavorite">
      <text class="cuIcon {{favorited ? 'cuIcon-favorfill text-orange' : 'cuIcon-favor text-gray'}}"></text>
      <text class="bar-action-text {{favorited ? 'text-orange' : ''}}">{{favorited ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="bar-action" bindtap="{{inCompare ? 'goCompare' : 'addToCompare'}}">
      <text class="cuIcon {{inCompare ? 'cuIcon-evaluate text-orange' : 'cuIcon-evaluate text-gray'}}"></text>
      <text class="bar-action-text {{inCompare ? 'text-orange' : ''}}">{{inCompare ? '对比' : '对比'}}</text>
    </view>
    <view class="bar-action" bindtap="onTapComment">
      <text class="cuIcon cuIcon-comment text-gray"></text>
      <text class="bar-action-text">评论</text>
    </view>
    <button class="bar-action share-btn" open-type="share">
      <text class="cuIcon cuIcon-share text-gray"></text>
      <text class="bar-action-text">分享</text>
    </button>
    <button class="bar-cta bg-blue" bindtap="startChat">
      <text class="cuIcon-messagefill"></text>
      <text style="margin-left: 8rpx;">私信</text>
    </button>
    <!-- <button class="bar-cta" bindtap="onBottomContact">
      <text>{{contactMethod === 'ad' ? '联系房东' : '支付 ¥1 联系'}}</text>
    </button> -->
  </view>

  <!-- 底部栏 -->
  <view class="bottom-bar" wx:if="{{detail}}">
    <view class="bar-action" bindtap="toggleFavorite">
      <text class="cuIcon {{favorited ? 'cuIcon-favorfill text-orange' : 'cuIcon-favor text-gray'}}"></text>
      <text class="bar-action-text {{favorited ? 'text-orange' : ''}}">{{favorited ? '已收藏' : '收藏'}}</text>
    </view>
    <view class="bar-action" bindtap="{{inCompare ? 'goCompare' : 'addToCompare'}}">
      <text class="cuIcon {{inCompare ? 'cuIcon-evaluate text-orange' : 'cuIcon-evaluate text-gray'}}"></text>
      <text class="bar-action-text {{inCompare ? 'text-orange' : ''}}">对比</text>
    </view>
    <view class="bar-action" bindtap="onTapComment">
      <text class="cuIcon cuIcon-comment text-gray"></text>
      <text class="bar-action-text">评论</text>
    </view>
    <button class="bar-action share-btn" open-type="share">
      <text class="cuIcon cuIcon-share text-gray"></text>
      <text class="bar-action-text">分享</text>
    </button>
    <button class="bar-cta {{chatVisible ? 'bg-blue' : 'bg-gray'}}" bindtap="startChat" style="width: 28%;">
      <text class="cuIcon cuIcon-messagefill"></text>
      <text style="margin-left: 8rpx; font-size: 26rpx;">{{isOwner ? (ownerHasChat ? '查看私信' : '私信') : '私信'}}</text>
    </button>
    <!-- <button class="bar-cta" bindtap="onBottomContact">
      <text>{{contactMethod === 'ad' ? '联系房东' : '支付 ¥1 联系'}}</text>
    </button> -->
  </view>

  <!-- 统一解锁 Dialog -->
  <view class="unlock-dialog-mask" wx:if="{{unlockDialogVisible}}" bindtap="closeUnlockDialog">
    <view class="unlock-dialog" catchtap="stopPropagation">
      <view class="dialog-title">{{unlockDialogTitle}}</view>
      <view class="dialog-desc">观看广告即可解锁当前房源信息，或成为VIP享受全部特权</view>

      <!-- 看广告解锁 -->
      <button class="dialog-ad-btn" bindtap="doUnlockByAd">
        <text class="cuIcon-videofill"></text>
        看广告解锁
      </button>

      <view class="dialog-divider"><text>或</text></view>

      <!-- VIP 会员选择区 -->
      <view class="dialog-vip-title">开通租客VIP</view>
      <view class="dialog-vip-plans">
        <view class="vip-plan" data-period="3" bindtap="buyVipInDialog">
          <text class="plan-name">7天体验</text>
          <text class="plan-price">¥9.9</text>
        </view>
        <view class="vip-plan vip-plan-hot" data-period="1" bindtap="buyVipInDialog">
          <text class="hot-tag">推荐</text>
          <text class="plan-name">月卡</text>
          <text class="plan-price">¥29.9</text>
        </view>
        <view class="vip-plan" data-period="2" bindtap="buyVipInDialog">
          <text class="plan-name">年卡</text>
          <text class="plan-price">¥99</text>
        </view>
      </view>

      <view class="dialog-vip-benefits">
        <text>✓ 免广告查看全部房源价格，描述详情</text>
        <text>✓ 免广告私信房东</text>
        <text>✓ 会员专享房源 </text>
      </view>

      <view class="dialog-close" bindtap="closeUnlockDialog">暂不需要</view>
    </view>
  </view>
</view>

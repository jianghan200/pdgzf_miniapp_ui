.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding-top: 10rpx;
}
.line-bar {
  background: #fff;
  padding: 20rpx 0;
}
.line-scroll {
  white-space: nowrap;
  padding: 0 20rpx;
}
.line-tag {
  display: inline-block;
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  margin-right: 16rpx;
}
.line-tag.active {
  color: #fff;
  font-weight: bold;
}

.station-section {
  background: #fff;
  margin-top: 16rpx;
  padding: 20rpx;
}
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.distance-picker {
  font-size: 26rpx;
  color: #e54d42;
}
.station-scroll {
  white-space: nowrap;
}
.station-list {
  display: inline-flex;
  flex-wrap: nowrap;
}
.station-tag {
  flex-shrink: 0;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  border-radius: 24rpx;
  margin-right: 12rpx;
  border: 2rpx solid transparent;
}
.station-tag.active {
  background: #fff5f5;
  color: #e54d42;
  border-color: #e54d42;
}

.house-list {
  padding: 20rpx;
}
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.house-cover-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}
.house-cover {
  width: 200rpx;
  height: 200rpx;
}
.house-info {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.house-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-meta {
  font-size: 24rpx;
  color: #999;
}
.house-subway {
  font-size: 24rpx;
  color: #0081ff;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.house-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.house-rent {
  color: #e54d42;
  font-size: 32rpx;
  font-weight: bold;
}
.house-time {
  font-size: 22rpx;
  color: #999;
}
.loading-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip {
  padding-top: 120rpx;
}
.empty-text {
  margin-top: 20rpx;
}

<wxs src="../../utils/tool.wxs" module="tools" />

<view style="height: 100vh; background-color: white;" style="padding-top: {{StatusBar}}px;" >
  <!-- <view class="bg-gray" style="height: 2.5rem;"></view> -->
  <!-- 标题 -->
  <view class="title bg-gray">
    <view class="margin-bottom" style="display: flex; flex-direction: row; align-items: center; " >
      <text class="text-bold margin-right">全部房源</text>
      <!-- 按钮功能区 -->
      <!-- 请求成功展示地图按钮 -->
      <button class="bg-white cu-btn shadow margin-right round" bindtap="openMap" wx:if="{{reqSuccessful}}">
        <text class="cuIcon-locationfill text-red text-bold"></text>地图
      </button>
      <button class="bg-white cu-btn shadow round" bindtap="openFilterDrawer" wx:if="{{reqSuccessful}}">
        <text class="cuIcon-filter text-blue text-bold"></text>筛选
      </button>
      <!-- 请求失败展示刷新按钮 -->
      <button class="bg-green cu-btn icon shadow" bindtap="refresh" wx:if="{{!reqSuccessful}}">
        <text class="cuIcon-refresh text-white"></text>
      </button>
    </view>
  </view>
  <!-- 搜索栏 -->
  <view class="cu-bar bg-white search">
    <view class="search-form round">
      <text class="cuIcon-search"></text>
      <input type="text" placeholder="搜索小区名字 / 地址 (支持如: ady -> 艾东苑)" confirm-type="search" bindinput="searchProject" />
    </view>
  </view>
</view>
<!-- <view style="height: 2.5rem;"></view> -->


<view wx:if="{{reqSuccessful}}">
  <scroll-view scroll-y scroll-with-animation style="background-color: #f1f1f1; height: 100%">
    <!-- 遍历社区 -->
    <view wx:for="{{list}}" wx:for-item="area" wx:key="areaId" id="main-{{index}}">
      <!-- 社区名称 -->
      <view class='cu-bar solid-bottom bg-white' wx:if="{{area.display}}">
        <view class='action'>
          <text class='cuIcon-titles text-red'></text> {{area.areaName == null ? '未知街道' : area.areaName}} 
        </view>
      </view>

      <!-- 遍历社区的小区 -->
      <view class="cu-list menu">
      <block wx:for="{{area.projects}}" wx:for-item="project" wx:key="pId">
        <view class="cu-item arrow" style="min-height: 80rpx;" bindtap="navToProject" data-pId="{{project.pId}}" wx:if="{{project.display}}">
          <view class="content">            
            <view>
              <!-- 是否订阅了某个小区 -->
              <view catchtap="subscribe" data-pid="{{project.pId}}" data-aid="{{area.areaId}}" data-pname="{{project.pName}}">
                <text class="text-red text-bold cuIcon-{{project.isSubscribed ? 'likefill' : 'like'}}"></text>
              </view>
              <!-- 小区名称 -->
              <view>
                <text class="text-black padding-left {{project.isSubscribed ? 'text-bold' : ''}}">{{tools.sliceOf(project.pName)}}</text>
                <text class="text-grey margin-left margin-right">{{project.rentableCount}}套</text>
                <text class="cuIcon-picfill text-grey text-xlg" wx:if="{{project.raw.hasImage}}"></text>
                <text class="cuIcon-videofill text-grey text-xlg" wx:if="{{project.raw.hasVideo}}"></text>
                <text class="cuIcon-post text-grey text-xlg" wx:if="{{project.raw.wp_url && project.raw.wp_url != null && project.raw.wp_url != ''}}"></text>
                <text class="text-grey margin-left">最低{{ project.floor }}元</text>
              </view>
            </view>
          </view>
        </view>
      </block>
      </view>

    </view>
  </scroll-view>
</view>

<!-- 筛选器弹窗 - 重新设计 -->
<view class="filter-modal {{ openDrawer ? 'show' : '' }}" bindtap="closeFilterDrawer">
  <view class="filter-container" catchtap>
    <!-- 头部 -->
    <view class="filter-header">
      <view class="filter-title">
        <text class="cuIcon-filter text-blue"></text>
        <text class="title-text">筛选房源</text>
        <button class="reset-btn-header" bindtap="resetFilter">
          <text class="cuIcon-refresh"></text>
          <text>重置</text>
        </button>
      </view>
      <view class="filter-close" bindtap="closeFilterDrawer">
        <text class="cuIcon-close"></text>
      </view>
    </view>

    <!-- 筛选内容 -->
    <scroll-view scroll-y class="filter-content">
      <!-- 社区筛选 -->
      <view class="filter-section">
        <view class="section-header" bindtap="changeAreaFilterDisplayStatus">
          <text class="cuIcon-location section-icon"></text>
          <text class="section-title">社区 ({{chosenAreas.length}}/{{areas.length}})</text>
          <text class="section-toggle cuIcon-{{ hideAreaFilter ? 'unfold' : 'fold' }}"></text>
        </view>
        <view class="tag-container" wx:if="{{!hideAreaFilter}}">
          <view class="tag-row">
            <view 
              class="filter-tag {{ areas.length == chosenAreas.length ? 'all-selected' : 'unselected' }}" 
              data-areaName="all" 
              bindtap="tapArea"
            >全选</view>
          </view>
          <view class="tag-grid">
            <block wx:for="{{areas}}" wx:for-item="areaName" wx:key="*this">
              <view 
                class="filter-tag {{ tools.indexOf(chosenAreas, areaName) == -1 ? 'unselected' : 'selected' }}"
                data-areaName="{{areaName}}" 
                bindtap="tapArea"
              >{{areaName}}</view>
            </block>
          </view>
        </view>
      </view>

      <!-- 小区房源数量 -->
      <view class="filter-section">
        <view class="section-header" bindtap="changeRentableCountsFilterDisplayStatus">
          <text class="cuIcon-number section-icon"></text>
          <text class="section-title">房源数量 ({{chosenRentableCountCategory.length}}/{{rentableCountCategory.length}})</text>
          <text class="section-toggle cuIcon-{{ hideRentableCountFilter ? 'unfold' : 'fold' }}"></text>
        </view>
        <view class="tag-container" wx:if="{{!hideRentableCountFilter}}">
          <view class="tag-row">
            <view 
              class="filter-tag {{ rentableCountCategory.length == chosenRentableCountCategory.length ? 'all-selected' : 'unselected' }}" 
              data-category="all"
              bindtap="tapRentableCounts"
            >全选</view>
          </view>
          <view class="tag-grid">
            <block wx:for="{{rentableCountCategory}}" wx:for-item="category" wx:key="*this">
              <view 
                class="filter-tag {{ tools.indexOf(chosenRentableCountCategory, category) == -1 ? 'unselected' : 'selected' }}" 
                data-category="{{category}}"
                bindtap="tapRentableCounts"
              >{{category}}</view>
            </block>
          </view>
        </view>
      </view>

      <!-- 户型 -->
      <view class="filter-section">
        <view class="section-header" bindtap="changeRoomTypesFilterDisplayStatus">
          <text class="cuIcon-home section-icon"></text>
          <text class="section-title">户型 ({{chosenRoomTypes.length}}/{{roomTypes.length}})</text>
          <text class="section-toggle cuIcon-{{ hideRoomTypesFilter ? 'unfold' : 'fold' }}"></text>
        </view>
        <view class="tag-container" wx:if="{{!hideRoomTypesFilter}}">
          <view class="tag-row">
            <view 
              class="filter-tag {{ roomTypes.length == chosenRoomTypes.length ? 'all-selected' : 'unselected' }}" 
              data-rtid="all"
              bindtap="tapRoomTypes"
            >全选</view>
          </view>
          <view class="tag-grid">
            <block wx:for="{{roomTypes}}" wx:for-item="roomType" wx:key="*this">
              <view 
                class="filter-tag {{ tools.indexOf(chosenRoomTypes, roomType) == -1 ? 'unselected' : 'selected' }}" 
                data-rtid="{{roomType}}"
                bindtap="tapRoomTypes"
              >{{ tools.id2RoomType(roomType) }}</view>
            </block>
          </view>
        </view>
      </view>

      <!-- 价格区间 -->
      <view class="filter-section">
        <view class="section-header" bindtap="changePriceFilterDisplayStatus">
          <text class="cuIcon-moneybagfill section-icon"></text>
          <text class="section-title">价格区间 ({{chosenPriceIntervals.length}}/{{priceIntervals.length}})</text>
          <text class="section-toggle cuIcon-{{ hidePriceFilter ? 'unfold' : 'fold' }}"></text>
        </view>
        <view class="tag-container" wx:if="{{!hidePriceFilter}}">
          <view class="tag-row">
            <view 
              class="filter-tag {{ priceIntervals.length == chosenPriceIntervals.length ? 'all-selected' : 'unselected' }}" 
              data-cap="all"
              bindtap="tapPriceIntervals"
            >全选</view>
          </view>
          <view class="tag-grid">
            <block wx:for="{{priceIntervals}}" wx:for-item="interval" wx:key="*this">
              <view 
                class="filter-tag {{ tools.interval_is_selected(chosenPriceIntervals, interval) ? 'selected' : 'unselected' }}" 
                data-floor="{{interval[0]}}"
                data-cap="{{interval[1]}}"
                bindtap="tapPriceIntervals"
              >{{ interval[0] }} ~ {{ interval[1] }}</view>
            </block>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="filter-footer">
      <button class="apply-btn" bindtap="closeFilterDrawer">
        <text class="cuIcon-check"></text>
        <text>应用筛选</text>
      </button>
    </view>
  </view>
</view>
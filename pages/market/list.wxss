.header-bar {
  background: #fff;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  position: sticky;
  top: 0;
  z-index: 10;
}
.header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}
.header-actions {
  display: flex;
  align-items: center;
}
.sort-bar {
  display: flex;
  gap: 40rpx;
  margin-top: 16rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #666;
}

.filter-drawer {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}
.filter-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.4);
}
.filter-content {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 80%;
  background: #fff;
  padding: 40rpx 30rpx;
  overflow-y: auto;
}
.filter-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}
.filter-group {
  margin-bottom: 30rpx;
}
.filter-label {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.filter-picker {
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  width: 100%;
}
.filter-input {
  background: #f5f5f5;
  padding: 16rpx 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  flex: 1;
}
.filter-sep {
  margin: 0 16rpx;
  color: #999;
}
.filter-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 60rpx;
}
.filter-actions .cu-btn {
  flex: 1;
}

.house-list {
  padding: 20rpx;
}
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.house-cover-wrap {
  position: relative;
  width: 220rpx;
  height: 220rpx;
  flex-shrink: 0;
}
.house-cover {
  width: 220rpx;
  height: 220rpx;
}
.house-info {
  flex: 1;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.house-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.house-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-vip {
  background: #fbbd08;
  color: #fff;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
}
.house-cert {
  position: absolute;
  top: 0;
  left: 0;
  background: #e54d42;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 0 0 8rpx 0;
}
.house-meta {
  font-size: 24rpx;
  color: #999;
  margin-top: 6rpx;
}
.house-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}
.house-rent {
  color: #e54d42;
  font-size: 34rpx;
  font-weight: bold;
}
.house-rent-unit {
  font-size: 22rpx;
  font-weight: normal;
}
.house-time {
  font-size: 22rpx;
  color: #ccc;
}

.cu-bar.search { padding: 16rpx 24rpx; background: #fff; }
.search-form { display: flex; align-items: center; background: #f5f5f5; border-radius: 32rpx; padding: 12rpx 20rpx; }
.search-form .cuIcon-search { font-size: 28rpx; color: #999; margin-right: 12rpx; }
.search-form input { flex: 1; font-size: 26rpx; }
.loading-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip {
  padding-top: 200rpx;
}
.empty-text {
  margin-top: 20rpx;
}

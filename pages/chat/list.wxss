/* ============================
   聊天列表
   ============================ */

/* ---------- 头部 ---------- */
.header {
  background: transparent;
  padding: 24rpx 28rpx 8rpx;
  display: flex;
  align-items: baseline;
}
.title {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1a2e;
  letter-spacing: -0.5rpx;
}
.sub {
  font-size: 24rpx;
  color: #aaa;
  margin-left: 16rpx;
  font-weight: 400;
}

/* ---------- 消息列表 ---------- */
.list {
  padding: 12rpx 24rpx;
}
.conv-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.15s ease;
}
.conv-card:active {
  transform: scale(0.98);
}

/* 头像 */
.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}
.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  background: #f0f0f0;
}
.online-dot {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: #4ade80;
  border: 3rpx solid #fff;
}

/* 内容区 */
.conv-main {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}
.conv-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.conv-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1a2e;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.conv-time {
  font-size: 22rpx;
  color: #ccc;
  flex-shrink: 0;
  margin-left: 12rpx;
}

/* 房源标签 */
.conv-house {
  margin-top: 10rpx;
}
.house-tag {
  display: inline-flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 8rpx;
  padding: 4rpx 14rpx;
}
.house-tag-icon {
  font-size: 20rpx;
  margin-right: 6rpx;
}
.house-text {
  font-size: 22rpx;
  color: #666;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  max-width: 400rpx;
}

/* 底部 */
.conv-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
}
.conv-last {
  font-size: 26rpx;
  color: #bbb;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}
.unread-text {
  color: #333;
  font-weight: 500;
}
.conv-right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 12rpx;
}
.badge {
  background: linear-gradient(135deg, #ff4757, #ff6b81);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  line-height: 36rpx;
  text-align: center;
  border-radius: 18rpx;
  padding: 0 10rpx;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(255, 71, 87, 0.3);
}
.del {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}
.del:active {
  background: #f5f5f5;
}
.del-icon {
  font-size: 24rpx;
  color: #ddd;
}

/* ---------- 空状态 ---------- */
.empty {
  text-align: center;
  padding: 120rpx 60rpx 80rpx;
}
.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #e8f4f8 0%, #d1ecf1 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 32rpx;
}
.empty-emoji {
  font-size: 64rpx;
}
.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  display: block;
  margin-bottom: 12rpx;
}
.empty-desc {
  font-size: 26rpx;
  color: #aaa;
  display: block;
  margin-bottom: 40rpx;
}
.empty-btn {
  display: inline-block;
  padding: 20rpx 56rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  color: #fff;
  border-radius: 48rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
}
.empty-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}

/* 保租房地图页样式 */
.map-wrap {
  width: 100%;
  height: 100vh;
  position: relative;
}

map {
  width: 100%;
  height: 100%;
}

/* 顶部信息栏 */
.top-bar {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  z-index: 10;
}

.legend {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #39b54a;
  margin-right: 12rpx;
}

.legend-dot.legend-dot-red {
  background: #e54d42;
}

.legend-text {
  font-size: 24rpx;
  color: #333;
  font-weight: 500;
}

.top-bar-right {
  display: flex;
  align-items: center;
}

.toggle-label-btn {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.toggle-label-btn.active {
  background: #e54d42;
}

.toggle-label-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}

.toggle-label-btn.active .toggle-label-text {
  color: #fff;
}

.reset-btn {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  margin-right: 12rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.12);
}

.reset-btn-text {
  font-size: 24rpx;
  color: #39b54a;
  font-weight: 500;
}

.list-btn {
  background: #39b54a;
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(57, 181, 74, 0.35);
}

.list-btn-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

/* 项目 customCallout 卡片 */
.project-callout {
  width: 360rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.15);
  position: relative;
}

.project-callout::after {
  content: '';
  position: absolute;
  bottom: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  border: 12rpx solid transparent;
  border-top-color: #fff;
  border-bottom: 0;
}

.callout-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.callout-row {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
  line-height: 1.4;
}

.callout-row.addr {
  color: #999;
  font-size: 22rpx;
}

.callout-btn {
  margin-top: 14rpx;
  background: #39b54a;
  color: #fff;
  font-size: 24rpx;
  text-align: center;
  padding: 12rpx 0;
  border-radius: 8rpx;
  font-weight: 500;
}

/* 列表按钮（激活时显示有筛选） */
.list-btn.active {
  background: #e54d42;
}

.list-btn.active .list-btn-text {
  color: #fff;
}

/* 列表内嵌筛选条 */
.list-filter-bar {
  padding: 16rpx 24rpx 8rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.lf-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.lf-chip {
  padding: 8rpx 22rpx;
  border-radius: 28rpx;
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  border: 1rpx solid #eee;
}

.lf-chip.chip-active {
  color: #39b54a;
  background: #e8f8ee;
  border-color: #39b54a;
}

/* 半屏列表 */
.list-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  z-index: 100;
  opacity: 0;
  visibility: hidden;
  transition: all 0.25s;
}

.list-mask.show {
  opacity: 1;
  visibility: visible;
}

.list-panel {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  max-height: 70vh;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 101;
  transform: translateY(100%);
  transition: transform 0.25s;
  display: flex;
  flex-direction: column;
}

.list-panel.show {
  transform: translateY(0);
}

.list-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.list-panel-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.list-close {
  font-size: 36rpx;
  color: #999;
  padding: 4rpx 8rpx;
}

.list-scroll {
  max-height: 60vh;
  padding: 12rpx 24rpx 40rpx;
}

.list-empty {
  text-align: center;
  padding: 80rpx 0;
  color: #999;
  font-size: 26rpx;
}

.list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.list-item:active {
  background: #f9f9f9;
}

.list-item-left {
  flex: 1;
  min-width: 0;
}

.list-item-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 6rpx;
}

.list-item-desc {
  font-size: 22rpx;
  color: #999;
}

.list-item-right {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
}

.list-item-count {
  font-size: 24rpx;
  color: #39b54a;
  font-weight: 500;
}

.list-item-right .cuIcon-right {
  font-size: 24rpx;
  color: #ccc;
  margin-left: 8rpx;
}

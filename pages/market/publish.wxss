.page-container {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 140rpx;
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: -12rpx;
  margin-bottom: 16rpx;
}

/* 身份选择 */
.identity-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.identity-card {
  border: 2rpx solid #e8e8e8;
  border-radius: 12rpx;
  padding: 24rpx;
  background: #fafafa;
  transition: all 0.2s;
}
.identity-card.active {
  border-color: #e54d42;
  background: #fff5f5;
}
.identity-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}
.identity-desc {
  font-size: 24rpx;
  color: #999;
}

/* 图片上传 */
.upload-cover {
  width: 100%;
  height: 320rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.upload-cover-title {
  font-size: 30rpx;
  color: #333;
  margin-top: 16rpx;
}
.upload-cover-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
}
.preview-img {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}
.image-index {
  position: absolute;
  top: 8rpx;
  left: 8rpx;
  background: rgba(229, 77, 66, 0.9);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}
.remove-btn {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 40rpx;
  height: 40rpx;
  background: #e54d42;
  color: #fff;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 32rpx;
}
.image-add-small {
  width: 200rpx;
  height: 200rpx;
  background: #f5f5f5;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.video-preview {
  position: relative;
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
  overflow: hidden;
}
.preview-video {
  width: 100%;
  height: 100%;
}
.video-play-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.3);
}
.media-type-tag {
  position: absolute;
  bottom: 8rpx;
  right: 8rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
}
.tips {
  margin-top: 20rpx;
}
.tip-item {
  font-size: 24rpx;
  color: #999;
  line-height: 1.8;
}

/* 标签选择 */
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag {
  background: #f5f5f5;
  color: #666;
  font-size: 26rpx;
  padding: 14rpx 28rpx;
  border-radius: 28rpx;
  border: 2rpx solid transparent;
}
.tag.active {
  background: #fff5f5;
  color: #e54d42;
  border-color: #e54d42;
}

/* 输入框 */
.block-input {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}
/* 自定义数字输入（点击"更多"后出现），不占满整行 */
.custom-num {
  width: 240rpx;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
}
.mt16 {
  margin-top: 16rpx;
}
.sub-address-row {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}
.sub-picker {
  width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
  text-align: center;
}
.sub-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}

.input-with-unit {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  height: 80rpx;
}
.unit-input {
  flex: 1;
  font-size: 28rpx;
}
.unit {
  font-size: 28rpx;
  color: #666;
  margin-left: 12rpx;
}
/* 自定义押金/付款月数输入，不占满整行 */
.custom-unit {
  width: 320rpx;
}

.floor-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.floor-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  text-align: center;
}
.floor-split {
  font-size: 32rpx;
  color: #999;
}

.date-picker {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.block-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
}

/* 表单行（费用/联系人） */
.form-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.form-item:last-child {
  border-bottom: none;
}
.form-label {
  width: 180rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}
.form-label.required::before {
  content: '* ';
  color: #e54d42;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  text-align: right;
}

/* 联系人 */
.contact-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.contact-avatar-btn {
  width: 96rpx;
  height: 96rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  border-radius: 50%;
  overflow: hidden;
  line-height: 1;
  flex-shrink: 0;
}
.contact-avatar-btn::after {
  border: none;
}
.contact-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f0f0f0;
}
.contact-info {
  flex: 1;
  margin-left: 20rpx;
}
.contact-nickname {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.contact-tip {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}
.contact-fill {
  font-size: 26rpx;
  color: #e54d42;
  border: 2rpx solid #e54d42;
  border-radius: 24rpx;
  padding: 8rpx 20rpx;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #e54d42;
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}
.submit-btn[disabled] {
  background: #f5a3a0;
  color: #fff;
}

.loading-box {
  text-align: center;
  padding: 200rpx;
}
.media-swiper {
  width: 100%;
  height: 500rpx;
}
.media-img {
  width: 100%;
  height: 100%;
}
.media-video {
  background: #000;
}
.media-count {
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  border-left: 6rpx solid #e54d42;
  padding-left: 16rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}
.price {
  font-size: 48rpx;
  font-weight: bold;
  color: #e54d42;
}
.price-unit {
  font-size: 26rpx;
  color: #e54d42;
}
.badge-vip {
  background: #fbbd08;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 16rpx;
}
.badge-cert {
  background: #e54d42;
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  margin-left: 8rpx;
}
.house-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-top: 12rpx;
}
.house-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}
.tag {
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
}

.location-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.location-text {
  font-size: 28rpx;
  color: #666;
}

.detail-grid {
  display: flex;
  flex-wrap: wrap;
}
.detail-item {
  width: 50%;
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 28rpx;
}
.detail-label {
  color: #999;
}
.detail-val {
  color: #333;
  font-weight: 500;
}

.facilities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.facility-tag {
  background: #eef;
  color: #6699cc;
  font-size: 26rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}
.facility-tag.nearby {
  background: #fef0e6;
  color: #e8954a;
}

.desc-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

.contact-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
}
.contact-name {
  font-size: 30rpx;
  font-weight: bold;
}
.contact-phone {
  font-size: 30rpx;
  color: #666;
  flex: 1;
}
.contact-label {
  font-size: 28rpx;
  color: #999;
  width: 120rpx;
  flex-shrink: 0;
}
.contact-val {
  font-size: 28rpx;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.xhs-row { margin-top: 16rpx; }
.xhs-url { color: #e54d42; }
.xhs-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

.contact-lock {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 28rpx 0;
  background: #f7f7f7;
  border-radius: 12rpx;
  margin-top: 8rpx;
  color: #999;
}
.contact-lock-text {
  font-size: 26rpx;
  color: #888;
}
.owner-actions {
  display: flex;
  gap: 20rpx;
}
.owner-actions .cu-btn {
  flex: 1;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.06);
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.contact-modal {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
}
.contact-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
}
.contact-modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  padding: 40rpx;
  border-radius: 24rpx 24rpx 0 0;
}
.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 12rpx;
}
.modal-desc {
  font-size: 26rpx;
  color: #999;
  text-align: center;
  margin-bottom: 24rpx;
}
.modal-textarea {
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 20rpx;
  width: 100%;
  height: 160rpx;
  font-size: 28rpx;
  margin-bottom: 24rpx;
}
.modal-actions {
  display: flex;
  gap: 20rpx;
}
.modal-actions .cu-btn {
  flex: 1;
}

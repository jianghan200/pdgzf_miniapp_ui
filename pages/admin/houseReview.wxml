<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh;">
  <view class="header">
    <text class="title">审核后台</text>
    <view class="nav-row">
      <view class="nav-item active">房源审核</view>
      <view class="nav-item" bindtap="goReports">举报处理</view>
      <view class="nav-item" bindtap="goDeposits">退款审核</view>
      <view class="nav-item" bindtap="goAuths">认证审核</view>
    </view>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-title">{{item.title}}</view>
      <view class="card-meta">{{item.district}} · {{item.house_type}} · {{item.area}}㎡ · ¥{{item.rent}}/月</view>
      <view class="card-actions">
        <button class="cu-btn bg-green sm" data-id="{{item.id}}" catchtap="approve">通过</button>
        <button class="cu-btn bg-gray sm" data-id="{{item.id}}" catchtap="openDetail">查看详情</button>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length == 0}}">暂无待审房源</view>
</view>

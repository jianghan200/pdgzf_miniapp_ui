.header-bar {
  background: #fff;
  padding: 16rpx 24rpx 12rpx;
  position: sticky;
  top: 0;
  z-index: 10;
}

/* ============================================
   §6.2 ② 通知条降噪
   - 去黄底、去脉冲点、高度 72→56rpx
   - 无背景色无边框，与搜索框合并进同一吸顶容器
   ============================================ */
.notice-bar {
  display: flex;
  align-items: center;
  padding: 0 12rpx;
  height: 56rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}
.notice-icon {
  font-size: 24rpx;
  color: #0F766E;
  flex-shrink: 0;
  margin-right: 10rpx;
}
.notice-swiper {
  flex: 1;
  height: 56rpx;
}
.notice-item {
  display: flex;
  align-items: center;
  height: 56rpx;
  padding: 0 4rpx;
}
.notice-text {
  font-size: 24rpx;
  color: #4B5563;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-weight: 400;
  line-height: 56rpx;
}

/* ============================================
   §6.2 ① Hero 降级 — 已删除，样式不再需要
   新增: 排序条内联统计 .new-count-dot / .new-count-text
   ============================================ */

/* ============================================
   §6.2 ③ 搜索框
   - 胶囊 + --color-fill 底，聚焦时描边 --color-primary
   ============================================ */
.cu-bar.search { padding: 12rpx 0; background: #fff; }
.search-form {
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 999rpx;
  padding: 12rpx 20rpx;
}
.search-form .cuIcon-search { font-size: 28rpx; color: #9CA3AF; margin-right: 12rpx; }
.search-form input { flex: 1; font-size: 26rpx; color: #1A1A1A; }

/* ============================================
   §6.2 ④ 快捷筛选
   - 选中态：主色浅底 + 主色文字 + 主色描边
   - "筛选" 按钮带 cuIcon-filter
   ============================================ */
.quick-filter-bar {
  display: flex;
  flex-wrap: nowrap;
  gap: 16rpx;
  margin-top: 16rpx;
  overflow-x: auto;
  padding-bottom: 8rpx;
}
.quick-tag {
  flex-shrink: 0;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
}
.quick-tag.active {
  background: #F0FDFA;
  color: #0F766E;
  border-color: #0F766E;
}
.quick-tag.more {
  background: #fff;
  border: 1rpx solid #EEF0F2;
  color: #4B5563;
}

/* ============================================
   §6.2 ④ 排序条 + 内联新上架统计
   ============================================ */
.sort-bar {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 12rpx;
}
.sort-item {
  font-size: 26rpx;
  color: #4B5563;
  display: flex;
  align-items: center;
  gap: 2rpx;
}
.sort-arrow {
  font-size: 20rpx;
  color: #9CA3AF;
}
.sort-right {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.new-count-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #0F766E;
  flex-shrink: 0;
}
.new-count-text {
  font-size: 22rpx;
  color: #0F766E;
  font-weight: 500;
}

/* ============================================
   §6 筛选抽屉
   - 高度自适应 max-height: 80vh（替代固定 85vh）
   - 抽屉保持不变
   ============================================ */
.filter-drawer {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 100;
  visibility: hidden;
  transition: visibility 0s 0.35s;
}
.filter-drawer.show {
  visibility: visible;
  transition: visibility 0s 0s;
}
.filter-mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0);
  transition: background 0.3s ease;
}
.filter-drawer.show .filter-mask {
  background: rgba(0, 0, 0, 0.45);
}

.filter-sheet {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  max-height: 80vh;
  background: #F7F8FA;
  border-radius: 28rpx 28rpx 0 0;
  display: flex;
  flex-direction: column;
  transform: translateY(100%);
  transition: transform 0.32s cubic-bezier(0.32, 0.72, 0, 1);
  overflow: hidden;
}
.filter-sheet.sheet-show {
  transform: translateY(0);
}

.sheet-handle {
  display: flex;
  justify-content: center;
  padding: 12rpx 0 4rpx;
}
.handle-bar {
  width: 56rpx;
  height: 6rpx;
  border-radius: 6rpx;
  background: #d8d8d8;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8rpx 32rpx 14rpx;
  background: #fff;
  border-bottom: 1rpx solid #EEF0F2;
}
.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.sheet-close {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F3F4F6;
}
.sheet-close .cuIcon-close {
  font-size: 24rpx;
  color: #9CA3AF;
}

.sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 0 20rpx;
}

/* ============================================
   §6.2 ⑦ 筛选分区 + 标签
   - 选中态统一主色体系
   - 去 emoji（wxml 已完成）
   ============================================ */
.filter-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-top: 16rpx;
}
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1A1A1A;
  margin-bottom: 14rpx;
  padding-left: 4rpx;
}
.sub-section {
  padding: 0;
}
.sub-section + .sub-section {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #EEF0F2;
}
.sub-label {
  font-size: 24rpx;
  font-weight: 500;
  color: #9CA3AF;
  display: block;
  margin-bottom: 12rpx;
}

.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.ftag {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 16rpx 0;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
  flex: 1;
  min-width: 0;
}
.ftag:active {
  transform: scale(0.96);
}
.ftag-sm {
  padding: 12rpx 0;
  font-size: 24rpx;
  border-radius: 10rpx;
}
.tag-cloud {
  gap: 12rpx;
}
.tag-cloud .ftag {
  flex: 0 0 auto;
  width: auto;
  padding: 12rpx 20rpx;
}
.tag-cloud .ftag:active {
  transform: scale(0.96);
}
.ftag-active {
  background: #F0FDFA;
  color: #0F766E;
  border-color: #0F766E;
  font-weight: 600;
}

/* 价格输入 */
.price-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.price-input-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  background: #F3F4F6;
  border-radius: 12rpx;
  padding: 0 16rpx;
  height: 68rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
}
.price-input-wrap:focus-within {
  border-color: #0F766E;
  background: #fff;
}
.price-prefix {
  font-size: 26rpx;
  font-weight: 600;
  color: #9CA3AF;
  margin-right: 6rpx;
}
.price-input {
  flex: 1;
  font-size: 26rpx;
  color: #1A1A1A;
  height: 68rpx;
}
.price-dash {
  font-size: 26rpx;
  color: #ccc;
}

/* ============================================
   §6.2 ⑦ 底部操作栏 — 确定按钮改主色
   ============================================ */
.sheet-footer {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 28rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #EEF0F2;
}
.btn-reset {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  padding: 0;
}
.btn-apply {
  flex: 2;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  background: #0F766E;
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 14rpx;
  border: none;
  padding: 0;
}
.btn-apply:active {
  opacity: 0.85;
}
.btn-reset:active {
  background: #ebedf0;
}

/* ============================================
   §6.2 ⑤ 房源卡片重排
   - 来源标签移至标题行（内联降饱和标签）
   - 价格黑色 40rpx/700
   - 认证标主色
   - 底部行合并入住时间+发布时间
   ============================================ */
.house-list {
  padding: 20rpx 24rpx;
  padding-bottom: 120rpx;
}
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}
.house-cover-wrap {
  position: relative;
  width: 220rpx;
  height: 240rpx;
  flex-shrink: 0;
}
.house-cover {
  width: 220rpx;
  height: 240rpx;
}

/* §3.3 来源标签 — 移至标题行，降饱和浅色底+深色字 */
.house-source-tag-inline {
  font-size: 20rpx;
  font-weight: 500;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  line-height: 1.5;
}
.house-source-tag-inline.owner {
  background: #ECFDF5;
  color: #047857;
}
.house-source-tag-inline.roommate {
  background: #EFF6FF;
  color: #1D4ED8;
}
.house-source-tag-inline.sublet {
  background: #FFF7E6;
  color: #B45309;
}
.house-source-tag-inline.apt {
  background: #F5F3FF;
  color: #6D28D9;
}

.house-info {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.house-title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.house-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-cert {
  background: #F0FDFA;
  color: #0F766E;
  font-size: 20rpx;
  padding: 2rpx 10rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  font-weight: 500;
}
.house-location {
  display: flex;
  align-items: center;
  gap: 0;
  margin-top: 8rpx;
}
.location-text {
  font-size: 24rpx;
  color: #4B5563;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.subway-dist {
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  margin-left: 4rpx;
}
.house-meta {
  font-size: 24rpx;
  color: #9CA3AF;
  margin-top: 8rpx;
}
.house-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 10rpx;
}
.price-wrap {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  flex: 1;
  min-width: 0;
}
.house-rent {
  color: #1A1A1A;
  font-size: 40rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-rent-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #9CA3AF;
}
.house-bottom-right {
  display: flex;
  align-items: center;
  gap: 0;
  flex-shrink: 0;
}
.move-in {
  font-size: 22rpx;
  color: #047857;
  flex-shrink: 0;
}
.house-time {
  font-size: 22rpx;
  color: #9CA3AF;
  flex-shrink: 0;
  white-space: nowrap;
}

/* ============================================
   加载状态
   ============================================ */
.loading-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #9CA3AF;
  font-size: 26rpx;
}
.empty-tip {
  padding-top: 200rpx;
}
.empty-text {
  margin-top: 20rpx;
}

/* ============================================
   §6.2 ⑥ FAB 发布按钮
   - 主色、96rpx、无阴影（仅卡片有阴影）
   ============================================ */
.fab-publish {
  position: fixed;
  right: 24rpx;
  bottom: calc(32rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  background: #0F766E;
  color: #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  z-index: 50;
}
.fab-publish:active {
  opacity: 0.85;
}
.fab-publish .cuIcon-add {
  font-size: 36rpx;
  line-height: 1;
}

.page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 状态标签 */
.status-tag {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  margin-left: 8rpx;
  flex-shrink: 0;
}
.status-pending {
  background: #fff3e0;
  color: #f57c00;
}
.status-online {
  background: #e8f5e9;
  color: #2e7d32;
}
.status-offline {
  background: #f5f5f5;
  color: #999;
}
.status-rejected {
  background: #ffebee;
  color: #c62828;
}

/* 房源卡片 */
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin: 20rpx 20rpx 0;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.house-card-header {
  display: flex;
  align-items: center;
  padding: 24rpx 24rpx 0;
}
.house-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-card-body {
  padding: 16rpx 24rpx;
}
.house-meta {
  font-size: 26rpx;
  color: #999;
  margin-top: 8rpx;
}
.house-meta:first-child {
  margin-top: 0;
}
.house-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
}
.house-rent {
  color: #e54d42;
  font-size: 32rpx;
  font-weight: bold;
}
.house-rent-unit {
  font-size: 22rpx;
  font-weight: normal;
}
.house-time {
  font-size: 22rpx;
  color: #ccc;
}
.house-card-actions {
  display: flex;
  gap: 16rpx;
  padding: 0 24rpx 20rpx;
}
.house-card-actions .cu-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 0 20rpx;
}

/* 驳回原因 */
.review-comment {
  margin: 8rpx 24rpx 0;
  padding: 16rpx;
  background: #fff3e0;
  border-radius: 8rpx;
  font-size: 24rpx;
  color: #e65100;
  line-height: 1.5;
}

/* 空状态 */
.empty-tip {
  text-align: center;
  padding-top: 200rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip .cuIcon-text {
  font-size: 80rpx;
}
.empty-text {
  margin-top: 20rpx;
}

/* 加载 */
.loading-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
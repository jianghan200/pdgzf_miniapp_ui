.loading-box {
  text-align: center;
  padding: 200rpx;
}

/* 冷启动/分享进入时的浮动返回市场图标 */
.market-float-back {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 99;
}
.float-market-img {
  width: 52rpx;
  height: 52rpx;
}

/* 冷启动/分享进入（栈底）时：导航栏左侧市场图标 */
.nav-market-icon {
  position: fixed;
  left: 8rpx;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}
.nav-market-img {
  width: 40rpx;
  height: 40rpx;
}

/* 图片轮播 */
.media-wrap {
  position: relative;
  width: 100%;
}
.media-swiper {
  width: 100%;
  height: 560rpx;
  background: #e8e8e8;
  display: block;
}
.media-img {
  width: 100%;
  height: 100%;
}
.media-video {
  background: #000;
}
.media-count {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  z-index: 10;
  line-height: 1.4;
}

/* 核心信息卡 */
.hero-card {
  background: #fff;
  margin: 0;
  padding: 28rpx 28rpx 0;
}
.hero-ext {
  background: #fff;
  padding: 0 28rpx 28rpx;
  margin-bottom: 16rpx;
}
.hero-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  line-height: 1.2;
}
.hero-tag.verified {
  background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);
  color: #fff;
}
.hero-tag.today {
  background: linear-gradient(135deg, #ffb347 0%, #ff5e62 100%);
  color: #fff;
}
.hero-tag.source {
  background: #f0f7ff;
  color: #3a86ff;
}
.hero-tag.source.owner {
  background: #fff0f0;
  color: #e54d42;
}
.hero-tag.source.roommate {
  background: #f0fff4;
  color: #39b54a;
}
.hero-tag.source.sublet {
  background: #fff8e6;
  color: #e5a100;
}
.hero-tag.source.apt {
  background: #f0f7ff;
  color: #0081ff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.hero-price-row {
  display: flex;
  align-items: baseline;
}
.hero-price {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff4d4f;
  letter-spacing: -1rpx;
}
.hero-price-unit {
  font-size: 26rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

/* 三栏快速信息 */
.quick-info {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 0;
  border-top: 1rpx solid #f2f2f2;
  margin-top: 24rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 4rpx;
}
.rent-type-icon {
  background: #fff1f0;
  color: #ff4d4f;
}
.location-icon {
  background: #e6f7ff;
  color: #1890ff;
}
.area-icon {
  background: #f6ffed;
  color: #52c41a;
}
.quick-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.quick-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-address {
  max-width: 180rpx;
}
.quick-sub {
  font-size: 22rpx;
  color: #999;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

/* 标签云 */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f2f2;
}
.cloud-tag {
  background: #f2f4f7;
  color: #4a5568;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1.2;
  font-weight: 500;
}

/* 亮点列表 */
.highlight-section {
  background: #fff;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.highlight-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ai-badge {
  display: inline-block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}
.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  border-bottom: 1rpx solid #f6f7f9;
}
.highlight-item:last-child {
  border-bottom: none;
}
.highlight-emoji {
  font-size: 32rpx;
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
}
.highlight-text {
  flex: 1;
  color: #333;
}

/* 通用 section */
.section {
  background: #fff;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 16rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #ff6b6b 0%, #ff4d4f 100%);
  border-radius: 3rpx;
}

/* 房屋属性网格（两列，每列左标签右值，中间有分隔） */
.detail-grid {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid #f0f0f0;
}
.detail-item {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f0f0;
  border-right: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}
.detail-item:nth-child(2n) {
  border-right: none;
  padding-right: 0;
}
.detail-item:nth-child(2n+1) {
  padding-left: 0;
}
.detail-item:nth-last-child(-n+2) {
  border-bottom: none;
  padding-bottom: 0;
}
.detail-label {
  color: #999;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.detail-val {
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 配套设施 */
.facilities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.facility-tag {
  background: #f0f7ff;
  color: #1890ff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}
.facility-tag.nearby {
  background: #fff4e6;
  color: #fa8c16;
}

/* 描述文本 */
.desc-text {
  font-size: 30rpx;
  color: #333;
  line-height: 2;
  letter-spacing: 0.5rpx;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 位置 */
.location-detail {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #444;
  margin-bottom: 12rpx;
}
.subway-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #1890ff;
}
.subway-icon {
  font-size: 28rpx;
  line-height: 1;
}

/* 地图占位 */
.map-placeholder {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d4e9f7 100%);
  border-radius: 12rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.map-placeholder-icon {
  font-size: 48rpx;
  color: #ff4d4f;
}
.map-placeholder-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.map-placeholder-tip {
  font-size: 22rpx;
  color: #999;
}

/* 联系方式 - 新版卡片 */
.contact-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f6f7f9;
}
.contact-row:last-child {
  border-bottom: none;
}
.contact-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  flex-shrink: 0;
}
.contact-avatar.wechat {
  background: linear-gradient(135deg, #07c160 0%, #06ae56 100%);
}
.contact-avatar.xhs {
  background: linear-gradient(135deg, #ff2442 0%, #e60026 100%);
}
.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}
.contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.contact-phone {
  font-size: 28rpx;
  color: #555;
}
.contact-label-sm {
  font-size: 22rpx;
  color: #999;
}
.contact-val {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.xhs-row { margin-top: 0; }
.xhs-url { color: #ff2442; }
.xhs-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 联系方式锁定状态 */
.contact-lock {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
}
.lock-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #999 0%, #666 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.lock-text-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.lock-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.lock-desc {
  font-size: 24rpx;
  color: #999;
}

/* 房东操作 */
.owner-actions {
  display: flex;
  gap: 20rpx;
}
.owner-actions .cu-btn {
  flex: 1;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 0;
  padding: 14rpx 16rpx;
  background: rgba(255,255,255,0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 -1rpx 0 rgba(0,0,0,0.06);
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.bar-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
}
.bar-action .cuIcon {
  font-size: 40rpx;
}
.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1.2;
}
.share-btn::after {
  border: none;
}
.share-btn::before {
  border: none;
}
.bar-action-text {
  font-size: 20rpx;
  color: #666;
}
.bar-cta {
  flex: 2.5;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4d4f 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bar-cta.bg-green {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}
.bar-cta::after {
  border: none;
}

.text-orange {
  color: #ff9500 !important;
}

/* 兼容颜色 */
.text-red { color: #e54d42; }
.text-blue { color: #0081ff; }
.text-gray { color: #999; }
.text-white { color: #fff; }
.bg-green { background: #39b54a; }
.bg-blue { background: #0081ff; }
.bg-red { background: #e54d42; }
.bg-gray { background: #909399; }
.bg-orange { background: #ff9500; }
.sm { font-size: 24rpx; padding: 8rpx 20rpx; line-height: 1.6; }
.round { border-radius: 32rpx; }

/* 内容门槛样式 */
.price-masked { letter-spacing: 2rpx; }
.price-unlock-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  margin-left: 20rpx;
  padding: 10rpx 20rpx;
  background: linear-gradient(135deg, #ff9500 0%, #ff6b00 100%);
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 149, 0, 0.3);
  vertical-align: middle;
}
.price-unlock-icon {
  font-size: 24rpx;
}
.price-unlock-text {
  font-size: 24rpx;
  color: #fff;
  font-weight: 600;
}
.desc-wrap { position: relative; overflow: hidden; }
.desc-masked .desc-text {
  display: -webkit-box; -webkit-line-clamp: 1;
  -webkit-box-orient: vertical; overflow: hidden;
  max-height: 60rpx;
}
.desc-fade-mask {
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 80rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0), #ffffff 80%);
  pointer-events: none;
}
.unlock-btn {
  margin-top: 16rpx; text-align: center; padding: 20rpx;
  background: #fff7e6; color: #ff9500;
  border-radius: 12rpx; font-size: 28rpx;
}

/* ========== 预约看房 CTA ========== */
.viewing-cta {
  display: flex; align-items: center; justify-content: space-between;
  padding: 28rpx 24rpx; margin: 0 24rpx;
  background: linear-gradient(135deg, #fff7e6 0%, #fff2cc 100%);
  border-radius: 16rpx; border: 2rpx solid #ffe0a3;
}
.viewing-cta:active { opacity: 0.8; }
.viewing-cta-left {
  display: flex; align-items: center; gap: 20rpx; flex: 1; min-width: 0;
}
.viewing-cta-text { display: flex; flex-direction: column; gap: 4rpx; }
.viewing-cta-title {
  font-size: 30rpx; font-weight: 600; color: #333;
}
.viewing-cta-desc {
  font-size: 24rpx; color: #999;
}

/* ========== 统一解锁 Dialog v2 ========== */
/* 设计原则：VIP 为主角，免费为配角，单一品牌色(琥珀金) */

/* 遮罩层 */
.unlock-dialog-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.55);
  z-index: 9999;
  display: flex; align-items: flex-end; justify-content: center;
}

/* 弹窗主体 */
.unlock-dialog {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  width: 100%;
  padding: 20rpx 36rpx 48rpx;
  box-sizing: border-box;
  max-height: 85vh;
  overflow-y: auto;
  position: relative;
}

/* 顶部关闭按钮 */
.dlg-close-top {
  position: absolute; top: 24rpx; right: 28rpx;
  width: 56rpx; height: 56rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  background: #f5f5f5;
  z-index: 2;
}
.dlg-close-top:active { background: #eee; }
.dlg-close-icon {
  font-size: 28rpx; color: #999; font-weight: 400;
  line-height: 1;
}

/* 标题区 */
.dlg-header {
  text-align: center;
  padding: 16rpx 0 28rpx;
}
.dlg-title {
  font-size: 38rpx; font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.dlg-subtitle {
  font-size: 26rpx; color: #888;
  line-height: 1.5;
}

/* ── VIP 主推区 ── */
.dlg-vip-section {
  background: linear-gradient(135deg, #fffbf5 0%, #fff8ed 50%, #fef3e2 100%);
  border: 2rpx solid #fde68a;
  border-radius: 24rpx;
  padding: 28rpx 24rpx 24rpx;
  margin-bottom: 32rpx;
  position: relative;
}
.dlg-vip-head {
  display: flex; align-items: center; justify-content: center;
  gap: 10rpx;
  margin-bottom: 24rpx;
}
.dlg-vip-icon {
  font-size: 28rpx; color: #d97706;
}
.dlg-vip-label {
  font-size: 28rpx; font-weight: 700;
  color: #92400e;
}

/* VIP 套餐卡片行 */
.dlg-vip-plans {
  display: flex; gap: 16rpx;
  margin-bottom: 20rpx;
}
.dlg-plan {
  flex: 1;
  background: #fff;
  border: 2rpx solid #f0e6d2;
  border-radius: 16rpx;
  padding: 20rpx 12rpx 16rpx;
  text-align: center;
  position: relative;
  transition: border-color 0.2s;
}
.dlg-plan:active { border-color: #d97706; }
.dlg-plan-name {
  display: block;
  font-size: 24rpx; color: #888;
  margin-bottom: 8rpx;
}
.dlg-plan-price {
  display: block;
  font-size: 36rpx; font-weight: 700;
  color: #1a1a1a;
  line-height: 1.2;
}
.dlg-plan-sub {
  display: block;
  font-size: 22rpx; color: #aaa;
  margin-top: 4rpx;
}
/* 推荐套餐 */
.dlg-plan-hot {
  border-color: #d97706;
  background: #fffbeb;
}
.dlg-plan-hot .dlg-plan-price {
  color: #d97706;
}
.dlg-plan-badge {
  position: absolute; top: -16rpx; left: 50%;
  transform: translateX(-50%);
  background: #d97706; color: #fff;
  font-size: 20rpx; font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* VIP 权益横排 */
.dlg-vip-perks {
  display: flex; flex-wrap: wrap;
  gap: 8rpx 20rpx;
  justify-content: center;
}
.dlg-perk {
  font-size: 22rpx; color: #a16207;
  line-height: 1.6;
}

/* ── 免费解锁区 ── */
.dlg-free-section {
  margin-bottom: 12rpx;
}

/* "或者免费解锁" 分隔线 */
.dlg-or-bar {
  display: flex; align-items: center;
  margin-bottom: 20rpx;
}
.dlg-or-line {
  flex: 1; height: 1rpx;
  background: #eee;
}
.dlg-or-text {
  font-size: 24rpx; color: #bbb;
  padding: 0 24rpx;
  white-space: nowrap;
}

/* 积分余额行 */
.dlg-credit-row {
  display: flex; align-items: center; justify-content: center;
  gap: 8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
}
.dlg-credit-label { color: #999; }
.dlg-credit-num {
  font-weight: 700; color: #d97706;
  font-size: 28rpx;
}
.dlg-credit-empty { color: #ef4444; }
.dlg-credit-action {
  color: #3b82f6; font-size: 24rpx;
  margin-left: 8rpx;
  display: inline;
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
  line-height: normal;
  min-height: auto;
}
.dlg-credit-action::after { border: none; }
.dlg-credit-action:active { opacity: 0.6; }

/* 免费按钮行 */
.dlg-free-btns {
  display: flex; gap: 16rpx;
  margin-bottom: 16rpx;
}
.dlg-free-btn {
  flex: 1; height: 96rpx;
  border-radius: 16rpx;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  border: none; padding: 0; margin: 0;
  line-height: 1.2;
}
.dlg-free-btn::after { border: none; }
.dlg-free-btn:active { opacity: 0.85; }
.dlg-free-main {
  font-size: 28rpx; font-weight: 600;
}
.dlg-free-tag {
  font-size: 22rpx; opacity: 0.8;
  margin-top: 2rpx;
}

/* 广告按钮 — 沉稳蓝色 */
.dlg-free-btn-ad {
  background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%);
  color: #fff;
}
/* 积分按钮 — 中性灰蓝 */
.dlg-free-btn-credit {
  background: linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
  color: #475569;
}
/* 积分不足时 */
.dlg-free-btn-off {
  background: #f1f5f9;
  color: #94a3b8;
}
/* 全宽按钮（积分体系关闭时） */
.dlg-free-btn-wide {
  width: 100%; flex: none;
  margin-bottom: 16rpx;
}

/* 分享赚积分 — 紧凑文字链 */
.dlg-share-link {
  display: flex; align-items: center; justify-content: center;
  gap: 6rpx;
  padding: 12rpx 0;
  background: transparent;
  border: none;
  border-radius: 0;
  line-height: normal;
  font-size: inherit;
  color: inherit;
}
.dlg-share-link::after { border: none; }
.dlg-share-link:active { opacity: 0.6; }
.dlg-share-text {
  font-size: 24rpx; color: #3b82f6;
}
.dlg-share-arrow {
  font-size: 28rpx; color: #93c5fd;
  line-height: 1;
}

/* 底部关闭 */
.dlg-dismiss {
  text-align: center;
  font-size: 28rpx; color: #bbb;
  padding: 20rpx 0 8rpx;
}
.dlg-dismiss:active { color: #999; }

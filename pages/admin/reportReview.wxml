<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh;">
  <view class="header">
    <text class="title">审核后台</text>
    <view class="nav-row">
      <view class="nav-item" bindtap="goHouses">房源审核</view>
      <view class="nav-item" bindtap="goComments">评论审核</view>
      <view class="nav-item active">举报处理</view>
      <view class="nav-item" bindtap="goDeposits">退款审核</view>
      <view class="nav-item" bindtap="goAuths">认证审核</view>
    </view>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="card-title">房源 #{{item.house_id}}</view>
      <view class="card-meta">举报人 #{{item.reporter_id}} · ¥{{item.fee}}</view>
      <view class="card-reason">{{item.reason}}</view>
      <view class="card-time">{{item.create_time}}</view>
      <view class="card-actions">
        <button class="cu-btn bg-green sm" data-id="{{item.id}}" bindtap="approve">成立</button>
        <button class="cu-btn bg-gray sm" data-id="{{item.id}}" bindtap="reject">驳回</button>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length == 0}}">暂无待处理举报</view>
</view>

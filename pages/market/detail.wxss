.loading-box {
  text-align: center;
  padding: 200rpx;
}

/* 冷启动/分享进入时的浮动返回市场图标 */
.market-float-back {
  position: fixed;
  right: 24rpx;
  bottom: 200rpx;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
  z-index: 99;
}
.float-market-img {
  width: 52rpx;
  height: 52rpx;
}

/* 冷启动/分享进入（栈底）时：导航栏左侧市场图标 */
.nav-market-icon {
  position: fixed;
  left: 8rpx;
  width: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10000;
}
.nav-market-img {
  width: 40rpx;
  height: 40rpx;
}

/* 图片轮播 */
.media-wrap {
  position: relative;
  width: 100%;
}
.media-swiper {
  width: 100%;
  height: 560rpx;
  background: #e8e8e8;
  display: block;
}
.media-img {
  width: 100%;
  height: 100%;
}
.media-video {
  background: #000;
}
.media-count {
  position: absolute;
  right: 28rpx;
  bottom: 28rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  font-size: 24rpx;
  padding: 4rpx 18rpx;
  border-radius: 20rpx;
  z-index: 10;
  line-height: 1.4;
}

/* 核心信息卡 */
.hero-card {
  background: #fff;
  margin: 0;
  padding: 28rpx 28rpx 0;
}
.hero-ext {
  background: #fff;
  padding: 0 28rpx 28rpx;
  margin-bottom: 16rpx;
}
.hero-tags {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.hero-tag {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 24rpx;
  line-height: 1.2;
}
.hero-tag.verified {
  background: linear-gradient(135deg, #ff9966 0%, #ff5e62 100%);
  color: #fff;
}
.hero-tag.today {
  background: linear-gradient(135deg, #ffb347 0%, #ff5e62 100%);
  color: #fff;
}
.hero-tag.source {
  background: #f0f7ff;
  color: #3a86ff;
}
.hero-tag.source.owner {
  background: #fff0f0;
  color: #e54d42;
}
.hero-tag.source.roommate {
  background: #f0fff4;
  color: #39b54a;
}
.hero-tag.source.sublet {
  background: #fff8e6;
  color: #e5a100;
}
.hero-tag.source.apt {
  background: #f0f7ff;
  color: #0081ff;
}

.hero-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1a1a1a;
  line-height: 1.4;
  margin-bottom: 12rpx;
}
.hero-price-row {
  display: flex;
  align-items: baseline;
}
.hero-price {
  font-size: 52rpx;
  font-weight: 700;
  color: #ff4d4f;
  letter-spacing: -1rpx;
}
.hero-price-unit {
  font-size: 26rpx;
  color: #ff4d4f;
  margin-left: 4rpx;
}

/* 三栏快速信息 */
.quick-info {
  display: flex;
  align-items: center;
  background: #fff;
  padding: 28rpx 0;
  border-top: 1rpx solid #f2f2f2;
  margin-top: 24rpx;
}
.quick-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}
.quick-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-bottom: 4rpx;
}
.rent-type-icon {
  background: #fff1f0;
  color: #ff4d4f;
}
.location-icon {
  background: #e6f7ff;
  color: #1890ff;
}
.area-icon {
  background: #f6ffed;
  color: #52c41a;
}
.quick-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}
.quick-main {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a1a;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-address {
  max-width: 180rpx;
}
.quick-sub {
  font-size: 22rpx;
  color: #999;
  max-width: 200rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.quick-divider {
  width: 1rpx;
  height: 60rpx;
  background: #f0f0f0;
}

/* 标签云 */
.tag-cloud {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #f2f2f2;
}
.cloud-tag {
  background: #f2f4f7;
  color: #4a5568;
  font-size: 26rpx;
  padding: 12rpx 24rpx;
  border-radius: 12rpx;
  line-height: 1.2;
  font-weight: 500;
}

/* 亮点列表 */
.highlight-section {
  background: #fff;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.highlight-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.ai-badge {
  display: inline-block;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  line-height: 1.4;
}
.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  border-bottom: 1rpx solid #f6f7f9;
}
.highlight-item:last-child {
  border-bottom: none;
}
.highlight-emoji {
  font-size: 32rpx;
  flex-shrink: 0;
  width: 40rpx;
  text-align: center;
}
.highlight-text {
  flex: 1;
  color: #333;
}

/* 通用 section */
.section {
  background: #fff;
  padding: 28rpx;
  margin-bottom: 16rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 16rpx;
}
.section-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(180deg, #ff6b6b 0%, #ff4d4f 100%);
  border-radius: 3rpx;
}

/* 房屋属性网格（两列，每列左标签右值，中间有分隔） */
.detail-grid {
  display: flex;
  flex-wrap: wrap;
  border-top: 1rpx solid #f0f0f0;
}
.detail-item {
  width: 50%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 20rpx;
  font-size: 26rpx;
  border-bottom: 1rpx solid #f0f0f0;
  border-right: 1rpx solid #f0f0f0;
  box-sizing: border-box;
}
.detail-item:nth-child(2n) {
  border-right: none;
  padding-right: 0;
}
.detail-item:nth-child(2n+1) {
  padding-left: 0;
}
.detail-item:nth-last-child(-n+2) {
  border-bottom: none;
  padding-bottom: 0;
}
.detail-label {
  color: #999;
  flex-shrink: 0;
  margin-right: 16rpx;
}
.detail-val {
  color: #333;
  font-weight: 500;
  text-align: right;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 配套设施 */
.facilities-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.facility-tag {
  background: #f0f7ff;
  color: #1890ff;
  font-size: 26rpx;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
}
.facility-tag.nearby {
  background: #fff4e6;
  color: #fa8c16;
}

/* 描述文本 */
.desc-text {
  font-size: 30rpx;
  color: #333;
  line-height: 2;
  letter-spacing: 0.5rpx;
  word-break: break-all;
  white-space: pre-wrap;
}

/* 位置 */
.location-detail {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #444;
  margin-bottom: 12rpx;
}
.subway-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 26rpx;
  color: #1890ff;
}
.subway-icon {
  font-size: 28rpx;
  line-height: 1;
}

/* 地图占位 */
.map-placeholder {
  margin-top: 20rpx;
  background: linear-gradient(135deg, #e8f4fd 0%, #d4e9f7 100%);
  border-radius: 12rpx;
  padding: 40rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}
.map-placeholder-icon {
  font-size: 48rpx;
  color: #ff4d4f;
}
.map-placeholder-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}
.map-placeholder-tip {
  font-size: 22rpx;
  color: #999;
}

/* 联系方式 - 新版卡片 */
.contact-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f6f7f9;
}
.contact-row:last-child {
  border-bottom: none;
}
.contact-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 36rpx;
  flex-shrink: 0;
}
.contact-avatar.wechat {
  background: linear-gradient(135deg, #07c160 0%, #06ae56 100%);
}
.contact-avatar.xhs {
  background: linear-gradient(135deg, #ff2442 0%, #e60026 100%);
}
.contact-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  overflow: hidden;
}
.contact-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.contact-phone {
  font-size: 28rpx;
  color: #555;
}
.contact-label-sm {
  font-size: 22rpx;
  color: #999;
}
.contact-val {
  font-size: 28rpx;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.xhs-row { margin-top: 0; }
.xhs-url { color: #ff2442; }
.xhs-hint {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #999;
  text-align: center;
}

/* 联系方式锁定状态 */
.contact-lock {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #fafafa;
  border-radius: 16rpx;
  border: 2rpx dashed #ddd;
}
.lock-icon-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #999 0%, #666 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  flex-shrink: 0;
}
.lock-text-box {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.lock-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
}
.lock-desc {
  font-size: 24rpx;
  color: #999;
}

/* 房东操作 */
.owner-actions {
  display: flex;
  gap: 20rpx;
}
.owner-actions .cu-btn {
  flex: 1;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 0;
  padding: 12rpx 16rpx;
  background: #fff;
  box-shadow: 0 -2rpx 12rpx rgba(0,0,0,0.06);
  padding-bottom: calc(12rpx + env(safe-area-inset-bottom));
  z-index: 100;
}
.bar-action {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 8rpx 0;
}
.bar-action .cuIcon {
  font-size: 40rpx;
}
.share-btn {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1.2;
}
.share-btn::after {
  border: none;
}
.share-btn::before {
  border: none;
}
.bar-action-text {
  font-size: 20rpx;
  color: #666;
}
.bar-cta {
  flex: 2.5;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff4d4f 100%);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 40rpx;
  border: none;
  margin-left: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.bar-cta.bg-green {
  background: linear-gradient(135deg, #52c41a 0%, #389e0d 100%);
}
.bar-cta::after {
  border: none;
}

.text-orange {
  color: #ff9500 !important;
}

/* 兼容颜色 */
.text-red { color: #e54d42; }
.text-blue { color: #0081ff; }
.text-gray { color: #999; }
.text-white { color: #fff; }
.bg-green { background: #39b54a; }
.bg-blue { background: #0081ff; }
.bg-red { background: #e54d42; }
.bg-gray { background: #909399; }
.bg-orange { background: #ff9500; }
.sm { font-size: 24rpx; padding: 8rpx 20rpx; line-height: 1.6; }
.round { border-radius: 32rpx; }

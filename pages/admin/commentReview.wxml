<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh;">
  <view class="header">
    <text class="title">审核后台</text>
    <view class="nav-row">
      <view class="nav-item" bindtap="goHouses">房源审核</view>
      <view class="nav-item active">评论审核</view>
      <view class="nav-item" bindtap="goReports">举报处理</view>
      <view class="nav-item" bindtap="goDeposits">退款审核</view>
      <view class="nav-item" bindtap="goAuths">认证审核</view>
    </view>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id">
      <view class="card-header">
        <image class="avatar" src="{{item.user_avatar}}" mode="aspectFill"></image>
        <view class="user-info">
          <view class="user-name">{{item.user_name}}</view>
          <view class="meta">{{item.target_type}} · {{item.create_time}}</view>
        </view>
      </view>
      <view class="card-content">{{item.content}}</view>
      <view class="card-images" wx:if="{{item.images && item.images.length > 0}}">
        <image wx:for="{{item.images}}" wx:for-item="img" wx:key="*this"
               class="img" src="{{img}}" mode="aspectFill"
               data-urls="{{item.images}}" data-current="{{img}}"
               catchtap="previewImage"></image>
      </view>
      <view class="card-actions">
        <button class="cu-btn bg-green sm" data-id="{{item.id}}" catchtap="approve">通过</button>
        <button class="cu-btn bg-red sm" data-id="{{item.id}}" catchtap="reject">拒绝</button>
      </view>
    </view>
  </view>
  <view class="empty" wx:if="{{!loading && list.length == 0}}">暂无待审评论</view>
</view>

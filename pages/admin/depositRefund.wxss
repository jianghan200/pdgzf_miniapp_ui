.header { background: #fff; padding: 20rpx 24rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.title { font-size: 36rpx; font-weight: bold; }
.nav-row { display: flex; gap: 20rpx; margin-top: 16rpx; overflow-x: auto; }
.nav-item { font-size: 26rpx; color: #666; padding: 8rpx 20rpx; border-radius: 20rpx; background: #f5f5f5; }
.nav-item.active { background: #e54d42; color: #fff; }
.list { padding: 20rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.card-title { font-size: 30rpx; font-weight: bold; }
.card-meta { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.card-time { font-size: 22rpx; color: #ccc; margin-top: 8rpx; margin-bottom: 16rpx; }
.empty { text-align: center; padding: 200rpx; color: #999; }

<wxs src="../../utils/tool.wxs" module="tools" />
<cu-custom bgColor="bg-black" isBack="{{false}}">
  <view slot="content">
    <view class="text-white text-bold">PD租房 - 保租房</view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh;">
  <view class="header-bar">
    <!-- 左：区域筛选按钮 -->
    <view class="filter-trigger" bindtap="openFilterDrawer">
      <text class="cuIcon-filter"></text>
      <text class="filter-trigger-text">区域</text>
      <text class="filter-badge" wx:if="{{selectedCount > 0}}">{{selectedCount}}</text>
    </view>
    <!-- 中：标题 -->
    <text class="header-title">上海保租房</text>
    <!-- 右：地图入口 -->
    <view class="map-entry" bindtap="openMap">
      <text class="cuIcon-locationfill"></text>
      <text class="map-entry-text">地图</text>
    </view>
  </view>
  <view class="cu-bar bg-white search">
    <view class="search-form round">
      <text class="cuIcon-search"></text>
      <input type="text" placeholder="搜索项目名称" confirm-type="search" bindinput="onSearchInput" />
    </view>
  </view>
  <view class="sort-bar">
    <view class="sort-tab {{chosenSort === item.key ? 'active' : ''}}"
          wx:for="{{sortTabs}}" wx:key="key"
          data-key="{{item.key}}" bindtap="tapSort">{{item.label}}</view>
  </view>
  <view class="list">
    <view class="card" wx:for="{{list}}" wx:key="id" data-id="{{item.id}}" bindtap="openDetail">
      <image class="card-cover" src="{{item.cover_url || '/assets/today.png'}}" mode="aspectFill"/>
      <view class="card-info">
        <view class="card-title">{{item.name}}</view>
        <view class="card-meta">{{item.district_name}} · {{item.address}}</view>
        <view class="card-meta">{{item.house_type_summary}}</view>
        <view class="card-badges">
          <text class="badge badge-queue" wx:if="{{item.turn_person_num > 0}}">排队{{item.turn_person_num}}人</text>
          <text class="badge badge-avail" wx:if="{{item.available}}">可租{{item.rent_flat_num}}套</text>
          <text class="badge badge-full" wx:elif="{{item.total_units > 0}}">满租</text>
          <text class="badge badge-ring" wx:if="{{item.ring_rd_name}}">{{item.ring_rd_name}}</text>
        </view>
        <view class="card-bottom">
          <text class="card-rent" wx:if="{{item.rent_low}}">¥{{item.rent_low}}-{{item.rent_high}}/月</text>
          <text class="card-rent" wx:else>租金待定</text>
          <text class="card-units">{{item.total_units}}套</text>
        </view>
      </view>
    </view>
  </view>
  <view class="loading-tip" wx:if="{{loading}}">加载中...</view>
  <view class="loading-tip" wx:if="{{!hasMore && list.length > 0}}">没有更多了</view>
  <view class="loading-tip" wx:if="{{!loading && list.length == 0}}">暂无项目</view>
</view>

<!-- 区域树状筛选 drawer -->
<view class="filter-modal {{openDrawer ? 'show' : ''}}" bindtap="closeFilterDrawer">
  <view class="filter-container" catchtap>
    <view class="filter-header" style="padding-top: {{menuTop}}px;">
      <view class="filter-title">
        <text class="cuIcon-locationfill filter-title-icon"></text>
        <text class="title-text">区域筛选</text>
      </view>
      <view class="filter-close" catchtap="closeFilterDrawer">
        <text class="cuIcon-close"></text>
      </view>
    </view>
    <scroll-view scroll-y class="filter-content">
      <!-- 全部区域 -->
      <view class="tree-node tree-root {{selectedDistrictIds.length === 0 && selectedBizcircleIds.length === 0 ? 'active' : ''}}" catchtap="toggleAllRegions">
        <text class="cuIcon-{{allExpanded ? 'fold' : 'unfold'}} tree-toggle"></text>
        <text class="tree-check {{selectedDistrictIds.length === 0 && selectedBizcircleIds.length === 0 ? 'cuIcon-roundcheck' : 'cuIcon-round'}}"></text>
        <text class="node-label">全上海</text>
      </view>
      <!-- 各区（默认收缩，点击"全上海"展开） -->
      <view class="tree-children" wx:if="{{allExpanded}}">
      <block wx:for="{{districtTree}}" wx:key="id">
        <view class="tree-node tree-district">
          <view class="tree-toggle" catchtap="toggleDistrict" data-id="{{item.id}}">
            <text class="cuIcon-{{item.expanded ? 'fold' : 'unfold'}}"></text>
          </view>
          <view class="tree-main" catchtap="tapDistrict" data-id="{{item.id}}">
            <text class="tree-check {{item.checked ? 'cuIcon-roundcheck' : 'cuIcon-round'}}"></text>
            <text class="node-label">{{item.name}}</text>
            <text class="node-count">{{item.project_count}}</text>
          </view>
        </view>
        <view class="tree-children" wx:if="{{item.expanded}}">
          <view class="tree-node tree-bizcircle"
                wx:for="{{item.children}}" wx:for-item="biz" wx:key="id"
                catchtap="tapBizcircle" data-id="{{biz.id}}">
            <text class="tree-check {{biz.checked ? 'cuIcon-roundcheck' : 'cuIcon-round'}}"></text>
            <text class="node-label">{{biz.name}}</text>
            <text class="node-count">{{biz.project_count}}</text>
          </view>
          <view class="tree-empty" wx:if="{{!item.children || item.children.length === 0}}">暂无街镇</view>
        </view>
      </block>
      </view>
      <!-- 户型筛选 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-homefill section-icon"></text>
          <text class="section-title">户型</text>
        </view>
        <view class="tag-grid">
          <view class="filter-tag {{tools.indexOf(chosenRoomTypes, item) !== -1 ? 'selected' : 'unselected'}}"
                wx:for="{{roomTypes}}" wx:key="*this"
                data-type="{{item}}" catchtap="tapRoomType">{{item}}</view>
        </view>
      </view>
      <!-- 价格区间 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-moneybagfill section-icon"></text>
          <text class="section-title">价格区间</text>
        </view>
        <view class="tag-grid">
          <view class="filter-tag {{chosenPriceIndex === index ? 'selected' : 'unselected'}}"
                wx:for="{{priceIntervals}}" wx:key="label"
                data-idx="{{index}}" catchtap="tapPriceInterval">{{item.label}}</view>
        </view>
        <view class="custom-price-row">
          <view class="custom-price-toggle" bindtap="toggleCustomPrice" data-on="{{customPriceMode}}">
            <text class="cuIcon-{{customPriceMode ? 'roundcheck' : 'round'}} custom-price-check"></text>
            <text class="custom-price-label">自定义</text>
          </view>
          <view class="custom-price-inputs" wx:if="{{customPriceMode}}">
            <input class="custom-price-input" type="number" placeholder="最低价" value="{{customPriceMin}}" bindinput="onCustomPriceMin"/>
            <text class="custom-price-sep">~</text>
            <input class="custom-price-input" type="number" placeholder="最高价" value="{{customPriceMax}}" bindinput="onCustomPriceMax"/>
            <text class="custom-price-unit">元/月</text>
          </view>
        </view>
      </view>
      <!-- 环线 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-locationfill section-icon"></text>
          <text class="section-title">环线</text>
        </view>
        <view class="tag-grid">
          <view class="filter-tag {{chosenRingRd === item ? 'selected' : 'unselected'}}"
                wx:for="{{ringRds}}" wx:key="*this"
                data-rd="{{item}}" catchtap="tapRingRd">{{item}}</view>
        </view>
      </view>
      <!-- 家电 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-homefill section-icon"></text>
          <text class="section-title">家电</text>
        </view>
        <view class="tag-grid">
          <view class="filter-tag {{tools.indexOf(chosenAppliances, item) !== -1 ? 'selected' : 'unselected'}}"
                wx:for="{{applianceOptions}}" wx:key="*this"
                data-a="{{item}}" catchtap="tapAppliance">{{item}}</view>
        </view>
      </view>
      <!-- 可租套数 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-homefill section-icon"></text>
          <text class="section-title">可租套数</text>
        </view>
        <view class="tag-grid">
          <view class="filter-tag {{chosenFlatIdx === index ? 'selected' : 'unselected'}}"
                wx:for="{{flatBuckets}}" wx:key="label"
                data-idx="{{index}}" catchtap="tapFlatBucket">{{item.label}}</view>
        </view>
      </view>
      <!-- 排队人数 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-peoplefill section-icon"></text>
          <text class="section-title">排队人数</text>
        </view>
        <view class="tag-grid">
          <view class="filter-tag {{chosenQueueIdx === index ? 'selected' : 'unselected'}}"
                wx:for="{{queueBuckets}}" wx:key="label"
                data-idx="{{index}}" catchtap="tapQueueBucket">{{item.label}}</view>
        </view>
      </view>
      <!-- 仅看可租 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-checkcirclefill section-icon"></text>
          <text class="section-title">仅看可租</text>
        </view>
        <switch checked="{{onlyAvailable}}" bindchange="toggleAvailable" color="#e54d42"/>
      </view>
    </scroll-view>
    <view class="filter-footer">
      <button class="reset-btn" catchtap="resetFilter">重置</button>
      <button class="apply-btn" catchtap="applyFilter">确定{{selectedCount > 0 ? '(' + selectedCount + ')' : ''}}</button>
    </view>
  </view>
</view>

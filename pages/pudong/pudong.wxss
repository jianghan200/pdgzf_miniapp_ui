/* 顶部导航栏 */
.toggle-bar {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 0 16rpx;
  border-bottom: 1rpx solid #eee;
  box-sizing: border-box;
}
.toggle-group {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 4rpx;
}
.toggle-btn {
  flex: 0 0 auto;
  padding: 10rpx 24rpx;
  font-size: 32rpx;
  color: #666;
  background: #f5f5f5;
}
.toggle-btn:first-child {
  border-radius: 24rpx 0 0 24rpx;
}
.toggle-btn:last-child {
  border-radius: 0 24rpx 24rpx 0;
}
.toggle-btn.active {
  background: #e54d42;
  color: #fff;
  font-weight: bold;
}
.action-group {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
}
.action-group .cu-btn {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 40rpx;
}
.right-spacer {
  flex: 0 0 auto;
}

.title {
  font-size: larger;
  font-weight: 700;
  padding: 0 1rem;
}

.worker-avatar {
  overflow: hidden;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}

.swiper_item {
  font-size: 25rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  letter-spacing: 2px;
}

.wide-btn {
  width: 100px !important;
}

/* 筛选器弹窗 */
.filter-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: rgba(0, 0, 0, 0.4);
  z-index: 9999;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
}
.filter-modal.show {
  opacity: 1;
  visibility: visible;
}
.filter-container {
  position: absolute;
  left: 0;
  top: 0;
  width: 75vw;
  max-width: 500rpx;
  height: 100vh;
  background: #fff;
  box-shadow: 8rpx 0 32rpx rgba(0, 0, 0, 0.15);
  display: flex;
  flex-direction: column;
  transform: translateX(-100%);
  transition: transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
}
.filter-modal.show .filter-container {
  transform: translateX(0);
}
.filter-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 24rpx 16rpx;
  border-bottom: 2rpx solid #f0f0f0;
  background: #fff;
  color: #333;
}
.filter-title {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
}
.filter-title .cuIcon-filter {
  color: #e54d42;
  margin-right: 12rpx;
  font-size: 28rpx;
}
.reset-btn-header {
  display: flex;
  align-items: center;
  margin-left: 12rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 24rpx;
  background: white;
  color: #666;
  font-size: 24rpx;
  font-weight: 500;
}
.reset-btn-header:active {
  background: #f5f5f5;
  border-color: #ccc;
}
.reset-btn-header text:first-child {
  margin-right: 6rpx;
  font-size: 20rpx;
}
.title-text {
  margin-left: 0;
}
.filter-close {
  padding: 8rpx;
  border-radius: 50%;
  background: #f5f5f5;
  font-size: 24rpx;
  color: #666;
}
.filter-close:active {
  background: #e54d42;
  color: white;
}
.filter-content {
  flex: 1;
  padding: 0 24rpx;
  overflow-y: auto;
}
.filter-section {
  margin: 24rpx 0;
}
.section-header {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
  margin-bottom: 16rpx;
}
.section-icon {
  font-size: 26rpx;
  color: #e54d42;
  margin-right: 12rpx;
}
.section-title {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
  color: #333;
}
.section-toggle {
  font-size: 24rpx;
  color: #999;
}
.sort-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}
.sort-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 16rpx;
  border: 2rpx solid #e8e8e8;
  border-radius: 16rpx;
  background: #fafafa;
  position: relative;
}
.sort-item.active {
  border-color: #e54d42;
  background: rgba(229, 77, 66, 0.1);
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 16rpx rgba(229, 77, 66, 0.2);
}
.sort-icon {
  font-size: 32rpx;
  color: #e54d42;
  margin-bottom: 8rpx;
}
.sort-text {
  font-size: 24rpx;
  color: #666;
  font-weight: 500;
}
.sort-item.active .sort-text {
  color: #e54d42;
  font-weight: 600;
}
.sort-arrow {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  font-size: 20rpx;
  color: #e54d42;
  font-weight: bold;
}
.tag-container {
  margin-top: 16rpx;
}
.tag-row {
  margin-bottom: 12rpx;
}
.tag-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}
.filter-tag {
  padding: 12rpx 18rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
  font-weight: 500;
  border: 2rpx solid transparent;
}
.filter-tag.unselected {
  background: #f5f5f5;
  color: #666;
  border-color: #e8e8e8;
}
.filter-tag.selected {
  background: rgba(229, 77, 66, 0.1);
  color: #e54d42;
  border-color: #e54d42;
  transform: translateY(-1rpx);
  box-shadow: 0 4rpx 12rpx rgba(229, 77, 66, 0.2);
}
.filter-tag.all-selected {
  background: rgba(229, 77, 66, 0.1);
  color: #e54d42;
  border-color: #e54d42;
  transform: translateY(-1rpx);
  box-shadow: 0 4rpx 12rpx rgba(229, 77, 66, 0.2);
}
.filter-footer {
  display: flex;
  padding: 20rpx 24rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 2rpx solid #f0f0f0;
  background: #fff;
}
.apply-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx;
  border: 2rpx solid #e54d42;
  border-radius: 12rpx;
  background: white;
  color: #e54d42;
  font-size: 26rpx;
  font-weight: 500;
}
.apply-btn:active {
  background: #e54d42;
  color: white;
}
.apply-btn text:first-child {
  margin-right: 6rpx;
  font-size: 22rpx;
}

@media (max-width: 750rpx) {
  .filter-container { width: 80vw; }
  .sort-grid { grid-template-columns: 1fr; }
}
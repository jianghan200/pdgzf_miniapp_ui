<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content" class="text-bold">我的评论/文章</view>
</cu-custom>

<!-- 按钮区 -->
<view class="cu-list grid col-4 no-border">
    <view class="cu-item" bindtap="handleIconClick" data-mode="0">
        <view class="cuIcon-notice" style="color: goldenrod;">
            <view class="cu-tag badge">{{ unreadMsgs.length == 0 ? '' : unreadMsgs.length }}</view>
        </view>
        <text>未读回复</text>
    </view>
    <view class="cu-item" bindtap="handleIconClick" data-mode="1">
        <view class="cuIcon-comment text-green">
            <view class="cu-tag badge">{{ comments.length == 0 ? '' : comments.length }}</view>
        </view>
        <text>我的评论</text>
    </view>
    <view class="cu-item" bindtap="handleIconClick" data-mode="2">
        <view class="cuIcon-community text-orange">
            <view class="cu-tag badge">{{ replies.length == 0 ? '' : replies.length }}</view>
        </view>
        <text>回复我的</text>
    </view>
    <view class="cu-item" bindtap="handleIconClick" data-mode="3">
        <view class="cuIcon-edit text-blue">
            <view class="cu-tag badge">{{ posts.length == 0 ? '' : posts.length }}</view>
        </view>
        <text>我的文章</text>
    </view>
</view>

<!-- 内容区 -->
<!-- 标题 -->
<view class="cu-bar bg-white solid-bottom">
    <view class="action">
        <text class="text-bold" style="font-size: larger;">{{ title }} </text>
        <text class="text-green">点击进入上下文</text>
    </view>
</view>

<!-- 内容列表 -->
<!-- 未读 -->
<view class="cu-list menu-avatar" wx:if="{{ mode == 0 }}">
    
</view>

<!-- 我的评论 -->
<view class="cu-list menu-avatar" wx:if="{{ mode == 1 }}">
    
</view>

<!-- 回复我的 -->
<view class="cu-list menu-avatar" wx:if="{{ mode == 2 }}">
    
</view>

<!-- 我的文章 -->
<view class="cu-list menu-avatar" wx:if="{{ mode == 3 }}">
    <view wx:for="{{ posts }}" wx:for-item="article" wx:key="_id">
        <!-- 话题详情卡片 -->
        <view class="cu-card case" bindtap="goToDetail" data-aid="{{ article._id }}">
            <view class="cu-item shadow">
                <!-- 图片信息（if any） -->
                <view class="image" wx:if="{{ article.images.length > 0 }}" >
                    <!-- 首图 -->
                    <image src="{{ article.images[0] }}" mode="aspectFill"></image>
                    <!-- 标题 -->
                    <view class="cu-bar bg-shadeBottom">
                        <text class="text-cut">{{ article.title }}</text>
                    </view>
                </view>

                <!-- 楼主信息 -->
                <view class="cu-list menu-avatar">
                    <view class="cu-item">
                        <!-- 楼主头像 -->
                        <view class="cu-avatar round lg" style="background-image:url({{article.user_avatar}});"></view>
                        <view class="content flex-sub">
                            <!-- 楼主昵称 -->
                            <view class="text-grey">{{ article.user_nickname }}</view>
                            <!-- 文章信息 -->
                            <view class="text-gray text-sm flex justify-between">
                                {{ article.timedistance }}
                                <view class="text-gray text-sm">
                                    <!-- 文章查看数量 -->
                                    <text class="cuIcon-attentionfill margin-lr-xs"></text> {{ article.view }}
                                    <!-- 文章评论数量 -->
                                    <text class="cuIcon-messagefill margin-lr-xs"></text> {{ article.comment_count }}
                                </view>
                            </view>
                        </view>
                    </view>
                </view>
                <!-- 没有图片的话题 -->
                <view wx:if="{{ article.images.length == 0 }}" class="card-title">{{ article.title }}</view>
            </view>
        </view>
    </view>
</view>
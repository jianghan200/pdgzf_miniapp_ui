/* ========== VIP 中心 v2 ========== */
/* 设计语言与解锁对话框统一：琥珀金品牌色，温暖卡片风格 */

/* 页面主体 */
.page-body {
  background: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* ── VIP 状态英雄卡 ── */
.vip-hero {
  display: flex; align-items: center; justify-content: space-between;
  margin: 20rpx 20rpx 0;
  padding: 28rpx 24rpx;
  background: linear-gradient(135deg, #fffbf5 0%, #fff8ed 50%, #fef3e2 100%);
  border: 2rpx solid #fde68a;
  border-radius: 20rpx;
}
.vip-hero-left {
  display: flex; align-items: center; gap: 16rpx;
}
.vip-hero-icon {
  font-size: 36rpx; color: #d97706;
}
.vip-hero-text {
  display: flex; flex-direction: column; gap: 4rpx;
}
.vip-hero-type {
  font-size: 30rpx; font-weight: 700; color: #92400e;
}
.vip-hero-expire {
  font-size: 24rpx; color: #a16207;
}
.vip-hero-badge {
  font-size: 24rpx; font-weight: 600;
  color: #d97706; background: #fffbeb;
  padding: 6rpx 16rpx; border-radius: 20rpx;
  border: 1rpx solid #fde68a;
}

/* ── Tab 切换栏 ── */
.tab-bar {
  display: flex;
  margin: 20rpx 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.04);
}
.tab-item {
  flex: 1; text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx; color: #888;
  border-radius: 12rpx;
  transition: all 0.25s;
}
.tab-item:active { opacity: 0.7; }
.tab-active {
  background: #d97706;
  color: #fff; font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(217,119,6,0.3);
}

/* ── Tab 内容区 ── */
.tab-content {
  margin-top: 20rpx;
}

/* ── 套餐卡片容器 ── */
.plans-card {
  margin: 0 20rpx;
  background: linear-gradient(135deg, #fffbf5 0%, #fff8ed 50%, #fef3e2 100%);
  border: 2rpx solid #fde68a;
  border-radius: 20rpx;
  padding: 24rpx 20rpx;
}

/* ── 套餐行 ── */
.plan-row {
  display: flex; gap: 16rpx;
}
.plan-row-2 { gap: 20rpx; }

/* ── 单个套餐格 ── */
.plan-cell {
  flex: 1;
  background: #fff;
  border: 2rpx solid #f0e6d2;
  border-radius: 16rpx;
  padding: 24rpx 12rpx 20rpx;
  text-align: center;
  position: relative;
  display: flex; flex-direction: column;
  align-items: center; gap: 6rpx;
  transition: border-color 0.2s;
}
.plan-cell:active { border-color: #d97706; }
.plan-label {
  font-size: 24rpx; color: #888;
}
.plan-amount {
  font-size: 40rpx; font-weight: 700;
  color: #1a1a1a; line-height: 1.2;
}
.plan-note {
  font-size: 22rpx; color: #aaa;
}
.plan-btn {
  margin-top: 12rpx;
  padding: 8rpx 28rpx;
  background: #d97706;
  color: #fff; font-size: 24rpx; font-weight: 600;
  border-radius: 20rpx;
}
.plan-cell:active .plan-btn {
  opacity: 0.8;
}

/* 推荐套餐 */
.plan-cell-hot {
  border-color: #d97706;
  background: #fffbeb;
}
.plan-cell-hot .plan-amount { color: #d97706; }
.plan-badge {
  position: absolute; top: -14rpx; left: 50%;
  transform: translateX(-50%);
  background: #d97706; color: #fff;
  font-size: 20rpx; font-weight: 600;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  white-space: nowrap;
}

/* ── 特权卡片 ── */
.perks-card {
  margin: 20rpx 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.perks-title {
  font-size: 28rpx; font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #d97706;
}
.perk-item {
  display: block;
  font-size: 26rpx; color: #d97706;
  padding: 8rpx 0;
  line-height: 1.6;
}

/* ── 订单记录卡 ── */
.orders-card {
  margin: 20rpx 20rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.03);
}
.orders-title {
  font-size: 28rpx; font-weight: 700;
  color: #1a1a1a;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  border-left: 6rpx solid #d97706;
}
.order-item {
  display: flex; align-items: center; justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f0eb;
}
.order-item:last-child { border-bottom: none; }
.order-left {
  display: flex; flex-direction: column; gap: 6rpx;
}
.order-type {
  font-size: 28rpx; color: #1a1a1a; font-weight: 500;
}
.order-time {
  font-size: 22rpx; color: #bbb;
}
.order-price {
  font-size: 32rpx; font-weight: 700; color: #d97706;
}

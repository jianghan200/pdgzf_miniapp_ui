<wxs src="../../utils/tool.wxs" module="tools" />

<view style="height: 100vh; background-color: white;" style="padding-top: {{StatusBar}}px;" wx:if="{{!disable}}">
  <!-- <view class="bg-gray" style="height: 2.5rem;"></view> -->
  <!-- 标题 -->
  <view class="title bg-gray">
    <view class="margin-bottom" style="display: flex; flex-direction: row; align-items: center;">
      <text class="text-bold">PD公租房</text>
      <!-- 按钮功能区 -->
      <button class="cu-btn text-bold icon bg-white margin-left shadow" bindtap="openMap">
        <text class="cuIcon-locationfill text-red text-bold"></text>
      </button>
      <button class="cu-btn text-bold icon bg-white margin-left shadow" bindtap="refresh">
        <text class="cuIcon-refresh text-green text-bold"></text>
      </button>
      <button class="cu-btn text-bold icon bg-white margin-left shadow" bindtap="openFilterDrawer">
        <text class="cuIcon-filter text-blue text-bold"></text> 
      </button>
      <button 
        wx:if="{{!isVip}}"
        class="wide-btn cu-btn text-bold cuIcon-vip icon bg-black text-yellow margin-left" 
        bindtap="vipSample"
      >VIP权益</button>
    </view>
    <view class="text-df" style="display: flex; justify-content: space-between; align-items: center;">
      <text class="text-bold"> 今日房源：{{milestone}}（{{projectCount}}小区，{{houseCount}}套房）</text>
    </view>
  </view>

  <!-- 滚动条 -->
  <swiper style="height: 55rpx; width: 100vw;" autoplay="true" interval="4000" circular="true">
    <block wx:for="{{broadcastMsgs}}" wx:for-item="msg" wx:key="*this">
      <navigator url="/pages/article/article?url={{msg.link}}" open-type="navigate">
        <swiper-item style="display: flex; align-items: center; justify-content: center;">
          <view class="swiper_item text-bold text-red">点击查看: {{msg.title.rendered}}</view>
        </swiper-item>
      </navigator>
    </block>
  </swiper>
  <!-- 对于初次登陆用户的提示 -->
  <view wx:if="{{!hasStartDate}}" class="text-bold text-grey flex" style="justify-content: center; align-items: center;">
    缺少资格日期，请至【我的】录入资格日(可模拟)
  </view>

  <!-- 房源列表 -->
  <view wx:if="{{list.length > 0}}">
    <scroll-view scroll-y scroll-with-animation style="height: 100%">
      <!-- 直接遍历项目列表 -->
      <view class="cu-list menu ">
        <block wx:for="{{list}}" wx:for-item="project" wx:key="*this" id="main-{{index}}">
          <view class="cu-item arrow" bindtap="navToProject" data-pId="{{project.pId}}">
            <view class="content padding-tb-sm">
              <view>
                <!-- 订阅 -->
                <view 
                  catchtap="subscribe"
                  data-pid="{{project.pId}}"
                  data-areaid="{{project.areaId}}"
                  data-pname="{{project.pName}}"
                >
                  <text class="text-red text-bold cuIcon-{{project.isSubscribed ? 'likefill' : 'like'}}"></text>
                </view>

                <!-- 小区地址 -->
                <view style="display: flex; flex-direction: row; align-items: center; justify-content: center;">
                  <text 
                    class="text-black padding-left {{project.isSubscribed ? 'text-bold' : ''}}"
                  >{{tools.sliceOf(project.pName)}} ({{project.houses.length}}套)
                  </text>
                  <text style="font-size: smaller; color: grey; padding-left: 10px;">预排：{{project.bestRank}}</text>
                  
                  <text style="font-size: smaller; color: grey; padding-left: 10px;"><text class="cuIcon-hot "></text> {{project.hotness}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
      <view class="cu-list menu margin-bottom">
        <view style="font-size: smaller; color: rgba(128, 128, 128, 0.705); padding-left: 10px;">预排：预计最靠前排名</view>
        <view style="font-size: smaller; color: rgba(128, 128, 128, 0.705); padding-left: 10px;"><text class="cuIcon-hot "></text>：参选本小区的所有人数</view>
      </view>

    </scroll-view>
  </view>

  <!-- 今日房源真的是一套都没有 -->
  <view wx:else style="display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <image class="worker-avatar" src="https://cdn.vencloud.cn/yzzz/default/cat.jpeg-detail_img" mode="aspectFill"></image>
    <view class="text-bold text-large padding">没了，真的一套都没了(ｰ ｰ;)，过几小时再看看吧～</view>
  </view>
</view>

<!-- 9:30 am ~ 10:03am 期间禁止选房 -->
<view wx:if="{{disable}}" style="height: 100vh; ">
  <view style="height: calc(100vh - calc(100rpx + env(safe-area-inset-bottom) / 2)); display: flex; flex-direction: column; align-items: center; justify-content: center;">
    <image class="worker-avatar" src="/assets/kid.jpeg" mode="aspectFill"></image>
    <text class="text-bold text-xl padding">每天上午9:30 ~ 10:00关闭选房通道。请于上午10:03后打开此页～（搬砖的手，微微颤抖）</text>
  </view>
</view>

<!-- 筛选器弹窗 - 重新设计 -->
<view class="filter-modal {{ openDrawer ? 'show' : '' }}" bindtap="closeFilterDrawer">
  <view class="filter-container" catchtap>
    <view class="bg-gray" style="height: 2.5rem;"></view>
    <!-- 头部 -->
    <view class="filter-header">
      <view class="filter-title">
        <text class="cuIcon-filter text-blue"></text>
        <text class="title-text">筛选房源</text>
        <button class="reset-btn-header" bindtap="resetFilter">
          <text class="cuIcon-refresh"></text>
          <text>重置</text>
        </button>
      </view>
      <view class="filter-close" bindtap="closeFilterDrawer">
        <text class="cuIcon-close"></text>
      </view>
    </view>

    <!-- 筛选内容 -->
    <scroll-view scroll-y class="filter-content">
      <!-- 快速排序 -->
      <view class="filter-section">
        <view class="section-header">
          <text class="cuIcon-sort section-icon"></text>
          <text class="section-title">排序</text>
        </view>
        <view class="sort-grid">
          <!-- <view 
            class="sort-item {{ sortBy === 'name' ? 'active' : '' }}" 
            data-sort="name" 
            bindtap="setSortBy"
          >
            <text class="cuIcon-title sort-icon"></text>
            <text class="sort-text">小区名</text>
            <text class="sort-arrow" wx:if="{{sortBy === 'name'}}">{{ sortOrder === 'asc' ? '↑' : '↓' }}</text>
          </view> -->
          <view 
            class="sort-item {{ sortBy === 'count' ? 'active' : '' }}" 
            data-sort="count" 
            bindtap="setSortBy"
          >
            <text class="cuIcon-home sort-icon"></text>
            <text class="sort-text">套数</text>
            <text class="sort-arrow" wx:if="{{sortBy === 'count'}}">{{ sortOrder === 'asc' ? '↑' : '↓' }}</text>
          </view>
          <view 
            class="sort-item {{ sortBy === 'rank' ? 'active' : '' }}" 
            data-sort="rank" 
            bindtap="setSortBy"
          >
            <text class="cuIcon-rank sort-icon"></text>
            <text class="sort-text">预排</text>
            <text class="sort-arrow" wx:if="{{sortBy === 'rank'}}">{{ sortOrder === 'asc' ? '↑' : '↓' }}</text>
          </view>
          <view 
            class="sort-item {{ sortBy === 'hotness' ? 'active' : '' }}" 
            data-sort="hotness" 
            bindtap="setSortBy"
          >
            <text class="cuIcon-hot sort-icon"></text>
            <text class="sort-text">热度</text>
            
            <text class="sort-arrow" wx:if="{{sortBy === 'hotness'}}">{{ sortOrder === 'asc' ? '↑' : '↓' }}</text>
          </view>
        </view>
      </view>



      <!-- 套数筛选 -->
      <view class="filter-section">
        <view class="section-header" bindtap="changeCountFilterDisplayStatus">
          <text class="cuIcon-number section-icon"></text>
          <text class="section-title">套数 ({{chosenCountCategories.length}}/{{countCategories.length}})</text>
          <text class="section-toggle cuIcon-{{ hideCountFilter ? 'unfold' : 'fold' }}"></text>
        </view>
        <view class="tag-container" wx:if="{{!hideCountFilter}}">
          <view class="tag-row">
            <view 
              class="filter-tag {{ countCategories.length == chosenCountCategories.length ? 'all-selected' : 'unselected' }}" 
              data-category="all"
              bindtap="tapCountCategory"
            >全选</view>
          </view>
          <view class="tag-grid">
            <block wx:for="{{countCategories}}" wx:for-item="category" wx:key="*this">
              <view 
                class="filter-tag {{ tools.indexOf(chosenCountCategories, category) == -1 ? 'unselected' : 'selected' }}" 
                data-category="{{category}}"
                bindtap="tapCountCategory"
              >{{category}}</view>
            </block>
          </view>
        </view>
      </view>
    </scroll-view>

    <!-- 底部操作栏 -->
    <view class="filter-footer">
      <button class="apply-btn" bindtap="closeFilterDrawer">
        <text class="cuIcon-check"></text>
        <text>应用筛选</text>
      </button>
    </view>
  </view>
</view>

<!-- 刷新房源后的Modal -->
<view class="cu-modal {{showModal ? 'show' : ''}}">
  <view class="cu-dialog">
    <view class="cu-bar bg-white justify-end">
      <view class="content text-bold">成功刷新房源数据</view>
      <view class="action" bindtap="hideModal">
        <text class="cuIcon-close text-red"></text>
      </view>
    </view>

    <view class="padding-xl text-green text-bold">更新于：{{timeStamp}}</view>
  </view>
</view>
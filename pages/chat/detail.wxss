/* 页面整体 flex 纵向布局 */
page {
  display: flex;
  flex-direction: column;
  height: 100%;
}

.house-bar {
  background: #fff; margin: 0; padding: 20rpx 24rpx;
  display: flex; justify-content: space-between; align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
  flex-shrink: 0;
}

/* 消息列表区域，flex:1 占满剩余空间，scroll-view 内部滚动 */
.chat-scroll {
  flex: 1;
  background: #f5f5f5;
  overflow: hidden;
}
.house-title { display: flex; align-items: center; min-width: 0; flex: 1; }
.house-label { font-size: 22rpx; color: #f44d56; border: 1rpx solid #f44d56; border-radius: 6rpx; padding: 2rpx 10rpx; margin-right: 16rpx; flex-shrink: 0; }
.house-name { font-size: 28rpx; color: #333; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.house-go { font-size: 26rpx; color: #999; flex-shrink: 0; margin-left: 12rpx; }

/* 聊天主体（复用 ColorUI 的 .cu-chat 原生样式） */
.cu-chat { padding: 20rpx 24rpx; }

/* 自己发的消息：头像在右，气泡在左，整体靠右 */
.cu-chat .cu-item.self>.cu-avatar {
  order: 2;
}
.cu-chat .cu-item.self>.main {
  order: 1;
  margin: 0 40rpx;
  justify-content: flex-end;
}
.cu-chat .cu-item.self .date {
  left: auto;
  right: 160rpx;
  text-align: right;
}
.chat-img { width: 300rpx; max-width: 60%; border-radius: 8rpx; display: block; }

.load-more { text-align: center; padding: 20rpx; color: #999; font-size: 24rpx; }
.empty { text-align: center; padding: 120rpx 40rpx; color: #999; }

/* 底部输入栏 */
.cu-bar.foot { position: fixed; bottom: 0; left: 0; right: 0; z-index: 100; }
.chat-input { flex: 1; margin: 0 16rpx; height: 68rpx; padding: 0 20rpx; border-radius: 34rpx; background: #f5f5f5; font-size: 28rpx; }

/* ========== 看房卡片样式 ========== */
.viewing-card-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0;
  width: 100%;
}
.viewing-card {
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.08);
  overflow: hidden;
  border-left: 8rpx solid #ccc;
}
.vc-border-orange { border-left-color: #ff9500; }
.vc-border-blue   { border-left-color: #0081ff; }
.vc-border-green  { border-left-color: #39b54a; }
.vc-border-gray   { border-left-color: #999; }
.vc-border-red    { border-left-color: #e54d42; }

.vc-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}
.vc-house {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.vc-badge {
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  color: #fff;
}
.vc-badge-orange { background: #ff9500; }
.vc-badge-blue   { background: #0081ff; }
.vc-badge-green  { background: #39b54a; }
.vc-badge-gray   { background: #999; }
.vc-badge-red    { background: #e54d42; }

.vc-body {
  padding: 20rpx 24rpx;
}
.vc-section {
  display: flex;
  flex-direction: column;
}
.vc-section-title {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 12rpx;
}
.vc-slots {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.vc-slot {
  display: inline-block;
  background: #e6f7ff;
  color: #1890ff;
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.vc-remark {
  font-size: 24rpx;
  color: #666;
  margin-top: 12rpx;
}
.vc-confirmed-time {
  font-size: 32rpx;
  font-weight: 600;
  color: #39b54a;
  margin: 4rpx 0;
}
.vc-weekday {
  font-size: 24rpx;
  color: #999;
}
.vc-contact {
  background: #f8f8f8;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}
.vc-contact-label {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 8rpx;
}
.vc-contact-val {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 4rpx;
}
.vc-fee-info {
  font-size: 24rpx;
  color: #ff9500;
  margin-top: 12rpx;
  text-align: right;
}

.vc-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 16rpx 24rpx 20rpx;
  border-top: 1rpx solid #f5f5f5;
  justify-content: flex-end;
}
.vc-btn {
  font-size: 24rpx;
  padding: 0 24rpx;
  height: 56rpx;
  line-height: 56rpx;
  border-radius: 28rpx;
  border: none;
  min-width: 120rpx;
  text-align: center;
}
.vc-btn-primary  { background: #0081ff; color: #fff; }
.vc-btn-success  { background: #39b54a; color: #fff; }
.vc-btn-danger   { background: #e54d42; color: #fff; }
.vc-btn-outline  { background: #fff; color: #0081ff; border: 2rpx solid #0081ff; }
.vc-btn-cancel   { background: #f5f5f5; color: #666; }

.vc-complaint {
  text-align: center;
  padding: 12rpx 0 16rpx;
  font-size: 24rpx;
  color: #999;
  border-top: 1rpx solid #f5f5f5;
}

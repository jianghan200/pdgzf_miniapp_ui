<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold">{{title}}</view>
  </view>
</cu-custom>
<!-- 图例 -->
<!-- 0~50, 51~100, 101~300, 301~400, 401~inf -->
<view style="height: 50px; margin: 5px;" wx:if="{{mode == 'today' || mode == 'all' || mode == 'single' || mode == 'singleToday'}}">
  <view class="text-bold">坐标颜色按房屋供给量分配</view>
  <text class="cuIcon-locationfill text-black"></text>
  <text>0~50</text>
  <text class="cuIcon-locationfill text-blue"></text>
  <text>51~100</text>
  <text class="cuIcon-locationfill text-green"></text>
  <text>101~300</text>
  <text class="cuIcon-locationfill text-orange"></text>
  <text>310~400</text>
  <text class="cuIcon-locationfill text-red"></text>
  <text> >= 401</text>
</view>
<!-- 保租房/市场房源图例 -->
<view style="padding: 8px 12px;" wx:if="{{mode == 'shbzf' || mode == 'market'}}">
  <text class="cuIcon-locationfill text-green"></text><text class="text-sm"> 保租房</text>
  <text class="cuIcon-locationfill text-orange margin-left"></text><text class="text-sm"> 市场房源</text>
  <text class="cuIcon-locationfill text-blue margin-left"></text><text class="text-sm"> 公租房</text>
</view>
<!-- 地图 -->
<view style="height: 100vh">
  <map
    id="map"
    subkey="2QUBZ-IJVWW-K6RRU-R7ANO-WSRSJ-PTBMG"
    latitude="{{selfLatitude}}"
    longitude="{{selfLongitude}}"
    markers="{{markers}}"
    scale="12"
    show-location
    bindmarkertap="onMarkerTap"
  >
    <cover-view slot="callout">
      <block wx:for="{{markers}}" wx:key="*this">
        <cover-view marker-id="{{item.id}}" class="customCallout">
          <cover-view class="text-bold" style="font-size: larger;">{{item.pname}}</cover-view>
          <cover-view class="text-blue text-bold">{{item.todayCountDesc}}</cover-view>
          <cover-view>{{item.countDesc}}</cover-view>
          <cover-view>{{item.appearCounts}}</cover-view>
          <cover-view>{{item.houseCounts}}</cover-view>
          <block wx:for="{{item.houseInfo}}" wx:for-item="info" wx:key="*this">
            <cover-view class="notice">{{info.houseType}}: {{info.size}}平 {{info.rent}}元</cover-view>
          </block>
          <block wx:for="{{item.queueNotice}}" wx:for-item="notice" wx:key="*this">
            <cover-view class="notice">{{notice}}</cover-view>
          </block>
        </cover-view>
      </block>
    </cover-view>
    <!-- 市场房源/保租房半屏列表 -->
    <cover-view class="market-list-panel {{showList ? 'show' : ''}}" wx:if="{{mode == 'market' || mode == 'shbzf'}}">
      <cover-view class="panel-handle" bindtap="toggleList">
        <cover-view class="handle-bar"></cover-view>
        <cover-view class="panel-title">{{mode == 'market' ? '市场房源' : '保租房'}} {{listData.length}} 套</cover-view>
      </cover-view>
      <scroll-view scroll-y class="panel-scroll" wx:if="{{showList}}">
        <cover-view class="panel-item" wx:for="{{listData}}" wx:key="id" data-id="{{item.id}}" bindtap="onListItemTap">
          <cover-view class="panel-name">{{item.title || item.project_name || item.address_name}}</cover-view>
          <cover-view class="panel-desc">{{item.district || ''}} {{item.town || ''}} {{item.district_name || ''}}</cover-view>
          <cover-view class="panel-bottom">
            <cover-view class="panel-rent">{{item.rent_display || (item.rent != null ? '¥' + item.rent : '价格待定')}}/月</cover-view>
            <cover-view class="panel-type">{{item.house_type || ''}}</cover-view>
          </cover-view>
        </cover-view>
      </scroll-view>
    </cover-view>
  </map>
</view>

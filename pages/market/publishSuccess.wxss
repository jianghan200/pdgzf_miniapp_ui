.success-box {
  text-align: center;
  padding: 120rpx 40rpx 60rpx;
}
.success-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-top: 30rpx;
}
.success-desc {
  font-size: 26rpx;
  color: #999;
  margin-top: 16rpx;
  line-height: 1.6;
}
.action-btns {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.action-btns .cu-btn {
  width: 100%;
}

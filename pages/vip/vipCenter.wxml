<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>

<view class="page-body">

  <!-- VIP 状态卡（已开通时显示） -->
  <view class="vip-hero" wx:if="{{vipInfo && vipInfo.is_market_vip}}">
    <view class="vip-hero-left">
      <text class="vip-hero-icon">✦</text>
      <view class="vip-hero-text">
        <text class="vip-hero-type">{{vipInfo.type == 11 ? '租客VIP' : '房东VIP'}}</text>
        <text class="vip-hero-expire">有效期至 {{vipInfo.end_time}}</text>
      </view>
    </view>
    <text class="vip-hero-badge">有效中</text>
  </view>

  <!-- Tab 切换 -->
  <view class="tab-bar">
    <view class="tab-item {{activeTab === 'tenant' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="tenant">
      <text>租客VIP</text>
    </view>
    <view class="tab-item {{activeTab === 'landlord' ? 'tab-active' : ''}}" bindtap="switchTab" data-tab="landlord">
      <text>房东VIP</text>
    </view>
  </view>

  <!-- 租客VIP -->
  <view class="tab-content" wx:if="{{activeTab === 'tenant'}}">
    <view class="plans-card">
      <view class="plan-row">
        <view class="plan-cell" data-period="3" bindtap="buyTenant">
          <text class="plan-label">体验</text>
          <text class="plan-amount">¥9.9</text>
          <text class="plan-note">7天 · 约1.4元/天</text>
          <view class="plan-btn">开通</view>
        </view>
        <view class="plan-cell plan-cell-hot" data-period="1" bindtap="buyTenant">
          <text class="plan-badge">推荐</text>
          <text class="plan-label">月卡</text>
          <text class="plan-amount">¥29.9</text>
          <text class="plan-note">/月 · 约1元/天</text>
          <view class="plan-btn">开通</view>
        </view>
        <view class="plan-cell" data-period="2" bindtap="buyTenant">
          <text class="plan-label">年卡</text>
          <text class="plan-amount">¥299</text>
          <text class="plan-note">/年 · 省¥59.8</text>
          <view class="plan-btn">开通</view>
        </view>
      </view>
    </view>

    <view class="perks-card">
      <view class="perks-title">会员特权</view>
      <text class="perk-item">✓ 会员专属房源</text>
      <text class="perk-item">✓ 免广告查看全部房源价格、描述详情、留言</text>
      <text class="perk-item">✓ 免看房服务费（每次省2元）</text>
      <text class="perk-item">✓ 专属客服</text>
    </view>
  </view>

  <!-- 房东VIP -->
  <view class="tab-content" wx:if="{{activeTab === 'landlord'}}">
    <view class="plans-card">
      <view class="plan-row plan-row-2">
        <view class="plan-cell" data-period="1" bindtap="buyLandlord">
          <text class="plan-label">月付</text>
          <text class="plan-amount">¥49</text>
          <text class="plan-note">/月</text>
          <view class="plan-btn">开通</view>
        </view>
        <view class="plan-cell plan-cell-hot" data-period="2" bindtap="buyLandlord">
          <text class="plan-badge">推荐</text>
          <text class="plan-label">年付</text>
          <text class="plan-amount">¥499</text>
          <text class="plan-note">/年 · 省¥89</text>
          <view class="plan-btn">开通</view>
        </view>
      </view>
    </view>

    <view class="perks-card">
      <view class="perks-title">房东特权</view>
      <text class="perk-item">✓ 租客优先推荐匹配</text>
      <text class="perk-item">✓ 快速审核（5分钟内）</text>
      <text class="perk-item">✓ VIP 标识提升曝光</text>
      <text class="perk-item">✓ 优先曝光</text>
    </view>
  </view>

  <!-- 订单记录 -->
  <view class="orders-card" wx:if="{{orders.length > 0}}">
    <view class="orders-title">订单记录</view>
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <view class="order-left">
        <text class="order-type">{{item.type == 11 ? '租客VIP' : '房东VIP'}} - {{item.period == 1 ? '月付' : item.period == 2 ? '年付' : item.period == 3 ? '7天' : '其他'}}</text>
        <text class="order-time">{{item.create_time}} · {{['待支付','生效中','已过期','已取消'][item.status]}}</text>
      </view>
      <text class="order-price">¥{{item.amount}}</text>
    </view>
  </view>

</view>

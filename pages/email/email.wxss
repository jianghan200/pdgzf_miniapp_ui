.userinfo {
  display: flex; 
  flex-direction: column; 
  padding: 10rpx; 
  align-items: center;
}

.avatar {
  overflow: hidden; 
  width: 150rpx; 
  height: 150rpx; 
  border-radius: 50%; 
  box-shadow: 3px 3px 10px rgba(218, 165, 32, 0.959);
  border: 5px solid goldenrod;
}

.worker-avatar {
  overflow: hidden; 
  width: 150rpx; 
  height: 150rpx; 
  border-radius: 50%; 
}

.nickname {
  color: goldenrod;
  font-weight: 500;
  font-size: x-large; 
  font-family: serif;
  padding: .5rem;
}
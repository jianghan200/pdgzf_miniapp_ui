.loading { text-align: center; padding: 200rpx; color: #999; }
.media { width: 100%; height: 400rpx; }
.media-img { width: 100%; height: 100%; }
.section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 16rpx; border-left: 6rpx solid #e54d42; padding-left: 16rpx; }
.title { font-size: 34rpx; font-weight: bold; }
.meta { font-size: 26rpx; color: #666; margin-top: 8rpx; }
.desc { font-size: 28rpx; color: #666; line-height: 1.6; }
.tags { display: flex; flex-wrap: wrap; gap: 12rpx; }
.tag { background: #eef; color: #6699cc; font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 6rpx; }
.textarea { background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; width: 100%; min-height: 160rpx; font-size: 28rpx; }
.actions { display: flex; gap: 20rpx; padding: 20rpx; }

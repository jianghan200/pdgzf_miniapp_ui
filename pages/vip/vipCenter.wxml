<cu-custom bgColor="bg-black" isBack="{{true}}">
  <view slot="backText">返回</view>
  <view slot="content">
    <view class="text-white text-bold"></view>
  </view>
</cu-custom>
<view style="background-color: #f5f5f5; min-height: 100vh;">
  <view class="header">
    <text class="header-title">VIP 中心</text>
    <view class="vip-status" wx:if="{{vipInfo && vipInfo.is_vip}}">
      <text class="vip-badge">{{vipInfo.type == 1 ? '租客VIP' : '房东VIP'}}</text>
      <text class="vip-expire">到期：{{vipInfo.end_time}}</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">租客 VIP</view>
    <view class="plan-row">
      <view class="plan-card">
        <text class="plan-name">月付</text>
        <text class="plan-price">¥9.9/月</text>
        <button class="cu-btn bg-red sm" data-period="1" bindtap="buyTenant">开通</button>
      </view>
      <view class="plan-card">
        <text class="plan-name">年付</text>
        <text class="plan-price">¥99/年</text>
        <button class="cu-btn bg-red sm" data-period="2" bindtap="buyTenant">开通</button>
      </view>
    </view>
    <view class="benefits">
      <text class="benefit">✓ 无限次联系房东</text>
      <text class="benefit">✓ 优先查看新房源</text>
      <text class="benefit">✓ 专属客服</text>
    </view>
  </view>

  <view class="section">
    <view class="section-title">房东 VIP</view>
    <view class="plan-row">
      <view class="plan-card">
        <text class="plan-name">月付</text>
        <text class="plan-price">¥49/月</text>
        <button class="cu-btn bg-red sm" data-period="1" bindtap="buyLandlord">开通</button>
      </view>
      <view class="plan-card">
        <text class="plan-name">年付</text>
        <text class="plan-price">¥499/年</text>
        <button class="cu-btn bg-red sm" data-period="2" bindtap="buyLandlord">开通</button>
      </view>
    </view>
    <view class="benefits">
      <text class="benefit">✓ 快速审核（4h内）</text>
      <text class="benefit">✓ VIP 标识提升曝光</text>
      <text class="benefit">✓ 无限发布套数</text>
    </view>
  </view>

  <view class="section" wx:if="{{orders.length > 0}}">
    <view class="section-title">订单记录</view>
    <view class="order-item" wx:for="{{orders}}" wx:key="id">
      <view class="order-top"><text>{{item.type == 1 ? '租客VIP' : '房东VIP'}} - {{item.period == 1 ? '月付' : '年付'}}</text><text class="order-price">¥{{item.amount}}</text></view>
      <view class="order-time">{{item.create_time}} · {{['待支付','生效中','已过期','已取消'][item.status]}}</view>
    </view>
  </view>
</view>

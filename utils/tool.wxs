function indexOf(arr, value) {
  return arr.indexOf(value)
}

function sliceOf(str) {
  if (str.indexOf('(') != -1) {
    return str.slice(str.indexOf('(') + 1, str.indexOf(')'))
  } else if (str.indexOf('（') != -1) {
    return str.slice(str.indexOf('（') + 1, str.indexOf('）'))
  } else {
    return str
  }
}

function id2RoomType(id) {
  return ["未知", "一室", "一室一厅", "两室", "两室一厅", "三室", "三室一厅", "四室", "五室"][id]
}

function interval_is_selected(intervals, interval) {
  var res = false
  for (var i = 0; i < intervals.length; i++) {
    if (intervals[i][0] == interval[0]) {
      res = true
      break
    }
  }
  return res
}

function shortType(type) {
  return type ? type.replace('一厅', '') : type
}

function videoName(url) {
  var parts = url.split('/')
  var filename = parts[parts.length - 1]
  return filename.split('.')[0]
}

module.exports = {
  indexOf : indexOf,
  sliceOf : sliceOf,
  id2RoomType: id2RoomType,
  interval_is_selected: interval_is_selected,
  shortType: shortType,
  videoName: videoName
}
.header { background: #fff; padding: 20rpx 24rpx; }
.title { font-size: 36rpx; font-weight: bold; }
.section { background: #fff; margin: 20rpx; border-radius: 16rpx; padding: 24rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; border-left: 6rpx solid #e54d42; padding-left: 16rpx; }
.textarea { background: #f5f5f5; border-radius: 12rpx; padding: 20rpx; width: 100%; min-height: 240rpx; font-size: 28rpx; }
.fee-tip { font-size: 28rpx; color: #fa8c16; text-align: center; }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; padding: 20rpx 24rpx; background: #fff; padding-bottom: calc(20rpx + env(safe-area-inset-bottom)); }

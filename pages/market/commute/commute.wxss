.page-container {
  background: #f5f5f5;
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: 40rpx;
}
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}
.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}
.search-row {
  display: flex;
  gap: 16rpx;
}
.search-input {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
}
.search-btn {
  width: 140rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: #e54d42;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0;
  margin: 0;
}
.address-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999;
}
.transport-row {
  display: flex;
  justify-content: space-between;
}
.transport-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 20rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 24rpx;
}
.transport-item .cuIcon {
  font-size: 40rpx;
}
.transport-item.active {
  background: #fff5f5;
  color: #e54d42;
}
.time-picker {
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: #333;
}

.result-section {
  margin-top: 10rpx;
}
.result-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}
.result-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.result-sub {
  font-size: 24rpx;
  color: #999;
}
.house-list {
  margin-top: 10rpx;
}
.house-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  display: flex;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.house-cover-wrap {
  width: 200rpx;
  height: 200rpx;
  flex-shrink: 0;
}
.house-cover {
  width: 200rpx;
  height: 200rpx;
}
.house-info {
  flex: 1;
  min-width: 0;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.house-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.house-meta {
  font-size: 24rpx;
  color: #999;
}
.commute-info {
  font-size: 24rpx;
  color: #39b54a;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.house-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.house-rent {
  color: #e54d42;
  font-size: 32rpx;
  font-weight: bold;
}
.house-layout {
  font-size: 24rpx;
  color: #999;
}
.loading-tip, .empty-tip {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}
.empty-tip {
  padding-top: 80rpx;
}
.empty-text {
  margin-top: 20rpx;
}
